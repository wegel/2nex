#!/bin/sh
# create-installer-usb: create a bootable USB disk image for installing nex
# usage: create-installer-usb <target-system-ref> <output.img>
#
# write to USB with: sudo dd if=output.img of=/dev/sdX bs=4M status=progress
set -eu

die() {
    printf "error: %s\n" "$*" >&2
    exit 1
}

usage() {
    printf "usage: %s <target-system-ref> <output.img>\n" "$0"
    printf "\n"
    printf "example:\n"
    printf "  %s systems/desktop-vwl/0.0.1 ./installer.img\n" "$0"
    printf "\n"
    printf "then write to USB:\n"
    printf "  sudo dd if=./installer.img of=/dev/sdX bs=4M status=progress\n"
    exit 1
}

[ $# -eq 2 ] || usage

TARGET_REF="$1"
OUTPUT_IMG="$2"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

INSTALLER_REF="systems/installer/0.0.1"
BOOTLOADER_SRC="$ROOT_DIR/src/bootloader"
BOOTLOADER_EFI="$BOOTLOADER_SRC/target/x86_64-unknown-uefi/debug/nex-bootloader.efi"

# check dependencies
command -v parted >/dev/null || die "parted not found"
command -v mkfs.vfat >/dev/null || die "mkfs.vfat not found (install dosfstools)"
command -v mke2fs >/dev/null || die "mke2fs not found (install e2fsprogs)"
command -v mcopy >/dev/null || die "mcopy not found (install mtools)"

# check refs exist
zub refs 2>/dev/null | grep -q " ${INSTALLER_REF}$" || die "installer not found: ${INSTALLER_REF}"
zub refs 2>/dev/null | grep -q " ${TARGET_REF}$" || die "target system not found: ${TARGET_REF}"

# build bootloader if needed
if [ ! -f "$BOOTLOADER_EFI" ]; then
    printf "building bootloader...\n"
    (cd "$BOOTLOADER_SRC" && cargo build) || die "bootloader build failed"
fi
[ -f "$BOOTLOADER_EFI" ] || die "bootloader not found at $BOOTLOADER_EFI"

# get target system checksum from ref metadata (or fall back to commit hash)
TARGET_CHECKSUM=$(zub show "${TARGET_REF}" 2>/dev/null | grep "nex.system.checksum:" | awk '{print $2}')
if [ -z "$TARGET_CHECKSUM" ]; then
    TARGET_CHECKSUM=$(zub rev-parse "${TARGET_REF}" 2>/dev/null)
fi
[ -n "$TARGET_CHECKSUM" ] || die "could not get checksum for ${TARGET_REF}"

# get installer checksum
INSTALLER_CHECKSUM=$(zub show "${INSTALLER_REF}" 2>/dev/null | grep "nex.system.checksum:" | awk '{print $2}')
if [ -z "$INSTALLER_CHECKSUM" ]; then
    INSTALLER_CHECKSUM=$(zub rev-parse "${INSTALLER_REF}" 2>/dev/null)
fi
[ -n "$INSTALLER_CHECKSUM" ] || die "could not get checksum for ${INSTALLER_REF}"

printf "creating installer USB image...\n"
printf "  installer: %s (%s)\n" "$INSTALLER_REF" "$INSTALLER_CHECKSUM"
printf "  target:    %s\n" "$TARGET_REF"
printf "  checksum:  %s\n" "$TARGET_CHECKSUM"

# create temp staging directory
STAGING=$(mktemp -d)
cleanup() { rm -rf "$STAGING"; }
trap cleanup EXIT

# disk layout: 1MB alignment + 64MB ESP + 3GB root
ESP_SIZE_MB=64
ROOT_SIZE_MB=3072
DISK_SIZE_MB=$((1 + ESP_SIZE_MB + ROOT_SIZE_MB))

printf "creating %dMB disk image...\n" "$DISK_SIZE_MB"
dd if=/dev/zero of="$OUTPUT_IMG" bs=1M count=$DISK_SIZE_MB status=none

printf "creating GPT partition table...\n"
parted -s "$OUTPUT_IMG" \
    mklabel gpt \
    mkpart ESP fat32 1MiB ${ESP_SIZE_MB}MiB \
    set 1 esp on \
    mkpart nex ext4 ${ESP_SIZE_MB}MiB 100%

# create ESP with bootloader
printf "creating ESP with bootloader...\n"
ESP_IMG="$STAGING/esp.img"
dd if=/dev/zero of="$ESP_IMG" bs=1M count=$((ESP_SIZE_MB - 1)) status=none
mkfs.vfat -F 32 "$ESP_IMG" >/dev/null
mmd -i "$ESP_IMG" ::/EFI
mmd -i "$ESP_IMG" ::/EFI/BOOT
mcopy -i "$ESP_IMG" "$BOOTLOADER_EFI" ::/EFI/BOOT/BOOTX64.EFI
dd if="$ESP_IMG" of="$OUTPUT_IMG" bs=1M seek=1 conv=notrunc status=none

# build root filesystem content
printf "building root filesystem...\n"
ROOT_CONTENT="$STAGING/root"
mkdir -p "$ROOT_CONTENT"

# checkout installer system
printf "  checking out installer system...\n"
DEPLOY_DIR="$ROOT_CONTENT/nex/deployments/${INSTALLER_CHECKSUM}.0"
mkdir -p "$DEPLOY_DIR"
zub checkout --copy "$INSTALLER_REF" "$DEPLOY_DIR"

# checkout target system to installer data area (inside deployment so accessible after switch_root)
printf "  checking out target system...\n"
mkdir -p "$DEPLOY_DIR/nex/installer"
zub checkout --copy "$TARGET_REF" "$DEPLOY_DIR/nex/installer/system"

# write target checksum
printf "%s" "$TARGET_CHECKSUM" > "$DEPLOY_DIR/nex/installer/system-checksum"

# copy bootloader for target installation
cp "$BOOTLOADER_EFI" "$DEPLOY_DIR/nex/installer/BOOTX64.EFI"

# create root symlinks to deployment (kernel runs /init from root, not from deployment)
DEPLOY_REL="nex/deployments/${INSTALLER_CHECKSUM}.0"
ln -sf "$DEPLOY_REL/usr" "$ROOT_CONTENT/usr"
ln -sf "$DEPLOY_REL/lib" "$ROOT_CONTENT/lib"
ln -sf "$DEPLOY_REL/lib64" "$ROOT_CONTENT/lib64"
ln -sf "$DEPLOY_REL/bin" "$ROOT_CONTENT/bin"
ln -sf "$DEPLOY_REL/sbin" "$ROOT_CONTENT/sbin"
ln -sf "$DEPLOY_REL/etc" "$ROOT_CONTENT/etc"
ln -sf usr/bin/init "$ROOT_CONTENT/init"

# create mount points
mkdir -p "$ROOT_CONTENT/mnt"

# create /nex/current and symlinks (needed for absolute package paths)
ln -sfn "deployments/${INSTALLER_CHECKSUM}.0" "$ROOT_CONTENT/nex/current"
ln -sfn "current/nex/pkg" "$ROOT_CONTENT/nex/pkg"
ln -sfn "current/nex/db" "$ROOT_CONTENT/nex/db"
ln -sfn "current/nex/installer" "$ROOT_CONTENT/nex/installer"

# debug: show what we're putting in the image
printf "DEBUG: root content structure:\n"
ls -la "$ROOT_CONTENT/"
printf "\nDEBUG: /init symlink:\n"
ls -la "$ROOT_CONTENT/init"
printf "\nDEBUG: deployment /init:\n"
ls -la "$DEPLOY_DIR/init" || echo "NOT FOUND"
head -5 "$DEPLOY_DIR/init" || echo "cannot read"
printf "\n"

# create ext4 filesystem
printf "creating ext4 filesystem...\n"
ROOT_IMG="$STAGING/root.img"
if command -v fakeroot >/dev/null; then
    fakeroot -- sh -c "chown -R 0:0 '$ROOT_CONTENT' && mke2fs -t ext4 -d '$ROOT_CONTENT' '$ROOT_IMG' ${ROOT_SIZE_MB}M" 2>/dev/null
else
    printf "  (warning: fakeroot not found, files may have wrong ownership)\n"
    mke2fs -t ext4 -d "$ROOT_CONTENT" "$ROOT_IMG" ${ROOT_SIZE_MB}M 2>/dev/null
fi
dd if="$ROOT_IMG" of="$OUTPUT_IMG" bs=1M seek=$ESP_SIZE_MB conv=notrunc status=none

# verify the ext4 image contents
printf "verifying ext4 image contents...\n"
debugfs -R "ls -l /" "$ROOT_IMG" 2>/dev/null
printf "\n/init in image:\n"
debugfs -R "stat /init" "$ROOT_IMG" 2>/dev/null | head -10
printf "\n/init symlink target:\n"
debugfs -R "cat /init" "$ROOT_IMG" 2>/dev/null | head -5
printf "\n/init actual file content:\n"
debugfs -R "cat /nex/deployments/${INSTALLER_CHECKSUM}.0/init" "$ROOT_IMG" 2>/dev/null | head -10
printf "\nall root symlinks:\n"
for f in bin sbin lib lib64 usr etc init; do
    printf "  /$f -> "
    debugfs -R "cat /$f" "$ROOT_IMG" 2>/dev/null || echo "(not symlink)"
done
printf "\ncheck for nested desktop init:\n"
debugfs -R "stat /nex/deployments/${INSTALLER_CHECKSUM}.0/nex/installer/system/init" "$ROOT_IMG" 2>/dev/null | head -3

printf "\ndisk image created: %s (%dMB)\n" "$OUTPUT_IMG" "$DISK_SIZE_MB"
printf "\nto use:\n"
printf "  sudo dd if=%s of=/dev/sdX bs=4M status=progress\n" "$OUTPUT_IMG"
printf "  (replace /dev/sdX with your USB device)\n"
printf "\nthen boot from USB and run 'nex-install'\n"
