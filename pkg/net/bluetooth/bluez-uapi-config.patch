diff -urN a/src/config-path.h b/src/config-path.h
--- a/src/config-path.h
+++ b/src/config-path.h
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#ifndef BLUEZ_CONFIG_PATH_H
+#define BLUEZ_CONFIG_PATH_H
+
+#include <limits.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static inline bool btd_config_path_join(char path[PATH_MAX],
+					const char *directory, size_t length,
+					const char *name)
+{
+	int written;
+
+	while (length > 1 && directory[length - 1] == '/')
+		length--;
+
+	written = snprintf(path, PATH_MAX, "%.*s/%s", (int) length,
+								directory, name);
+	if (written < 0 || written >= PATH_MAX) {
+		path[0] = '\0';
+		return false;
+	}
+
+	return access(path, F_OK) == 0;
+}
+
+static inline bool btd_config_path_from_list(char path[PATH_MAX],
+					const char *name, const char *directories)
+{
+	const char *start = directories;
+
+	while (start && *start) {
+		const char *end = strchr(start, ':');
+		size_t length = end ? (size_t) (end - start) : strlen(start);
+
+		if (length > 0 && btd_config_path_join(path, start, length, name))
+			return true;
+
+		start = end ? end + 1 : NULL;
+	}
+
+	path[0] = '\0';
+	return false;
+}
+
+static inline bool btd_config_path_from_dirs(char path[PATH_MAX],
+					const char *name,
+					const char *const directories[],
+					size_t count)
+{
+	size_t i;
+
+	for (i = 0; i < count; i++) {
+		if (btd_config_path_join(path, directories[i],
+							strlen(directories[i]), name))
+			return true;
+	}
+
+	path[0] = '\0';
+	return false;
+}
+
+static inline bool btd_config_path(char path[PATH_MAX], const char *name)
+{
+	const char *service_directories = getenv("CONFIGURATION_DIRECTORY");
+	const char *const system_directories[] = {
+		CONFIGDIR,
+		"/run/bluetooth",
+		"/usr/lib/bluetooth",
+	};
+
+	if (service_directories &&
+			btd_config_path_from_list(path, name,
+						service_directories))
+		return true;
+
+	return btd_config_path_from_dirs(path, name, system_directories,
+					sizeof(system_directories) /
+					sizeof(system_directories[0]));
+}
+
+#endif
