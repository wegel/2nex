diff --git a/unit/test-config-path.c b/unit/test-config-path.c
new file mode 100644
index 0000000..2434a76
--- /dev/null
+++ b/unit/test-config-path.c
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#define _GNU_SOURCE
+#define CONFIGDIR "/etc/bluetooth"
+
+#include <assert.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "src/config-path.h"
+
+static void make_file(const char *path)
+{
+	int fd = open(path, O_CREAT | O_TRUNC | O_WRONLY, 0600);
+
+	assert(fd >= 0);
+	assert(close(fd) == 0);
+}
+
+static void expect_path(const char *actual, const char *directory,
+					const char *name)
+{
+	char expected[PATH_MAX];
+
+	assert(snprintf(expected, sizeof(expected), "%s/%s", directory,
+							name) < (int) sizeof(expected));
+	assert(strcmp(actual, expected) == 0);
+}
+
+static void test_name(const char *root, const char *name)
+{
+	char admin[PATH_MAX], runtime[PATH_MAX], vendor[PATH_MAX];
+	char admin_file[PATH_MAX], runtime_file[PATH_MAX], vendor_file[PATH_MAX];
+	char explicit_dirs[PATH_MAX * 2], path[PATH_MAX];
+	const char *directories[3];
+
+	assert(snprintf(admin, sizeof(admin), "%s/admin", root) > 0);
+	assert(snprintf(runtime, sizeof(runtime), "%s/run", root) > 0);
+	assert(snprintf(vendor, sizeof(vendor), "%s/vendor", root) > 0);
+	assert(snprintf(admin_file, sizeof(admin_file), "%s/%s", admin, name) > 0);
+	assert(snprintf(runtime_file, sizeof(runtime_file), "%s/%s", runtime,
+							name) > 0);
+	assert(snprintf(vendor_file, sizeof(vendor_file), "%s/%s", vendor,
+							name) > 0);
+	directories[0] = admin;
+	directories[1] = runtime;
+	directories[2] = vendor;
+
+	make_file(vendor_file);
+	assert(btd_config_path_from_dirs(path, name, directories, 3));
+	expect_path(path, vendor, name);
+
+	make_file(runtime_file);
+	assert(btd_config_path_from_dirs(path, name, directories, 3));
+	expect_path(path, runtime, name);
+
+	make_file(admin_file);
+	assert(btd_config_path_from_dirs(path, name, directories, 3));
+	expect_path(path, admin, name);
+
+	assert(unlink(admin_file) == 0);
+	assert(unlink(runtime_file) == 0);
+	assert(snprintf(explicit_dirs, sizeof(explicit_dirs), "%s/missing:%s",
+							root, vendor) > 0);
+	assert(setenv("CONFIGURATION_DIRECTORY", explicit_dirs, 1) == 0);
+	assert(btd_config_path(path, name));
+	expect_path(path, vendor, name);
+
+	assert(setenv("CONFIGURATION_DIRECTORY", admin, 1) == 0);
+	assert(!btd_config_path(path, name));
+	assert(path[0] == '\0');
+	assert(unsetenv("CONFIGURATION_DIRECTORY") == 0);
+	assert(unlink(vendor_file) == 0);
+}
+
+int main(void)
+{
+	char root[] = "/tmp/bluez-config-path-XXXXXX";
+	char path[PATH_MAX];
+	const char *names[] = { "main.conf", "input.conf", "network.conf" };
+	size_t i;
+
+	assert(mkdtemp(root));
+	for (i = 0; i < 3; i++) {
+		assert(snprintf(path, sizeof(path), "%s/%s", root,
+							i == 0 ? "admin" :
+							i == 1 ? "run" : "vendor") > 0);
+		assert(mkdir(path, 0700) == 0);
+	}
+
+	for (i = 0; i < sizeof(names) / sizeof(names[0]); i++)
+		test_name(root, names[i]);
+
+	assert(snprintf(path, sizeof(path), "%s/admin", root) > 0);
+	assert(rmdir(path) == 0);
+	assert(snprintf(path, sizeof(path), "%s/run", root) > 0);
+	assert(rmdir(path) == 0);
+	assert(snprintf(path, sizeof(path), "%s/vendor", root) > 0);
+	assert(rmdir(path) == 0);
+	assert(rmdir(root) == 0);
+	return 0;
+}
