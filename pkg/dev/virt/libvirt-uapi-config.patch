                     int *len,
                     virConf *conf);
+char *virConfFindSystemConfig(const char *name);
 int virConfLoadConfig(virConf **conf, const char *name);
--- a/src/util/virconf.c
+++ b/src/util/virconf.c
@@ -1490,12 +1490,32 @@
     return use;
 }
 
+char *
+virConfFindSystemConfig(const char *name)
+{
+    const char *directories[] = {
+        SYSCONFDIR "/libvirt",
+        "/run/libvirt",
+        LIBDIR "/libvirt",
+    };
+    size_t i;
+
+    for (i = 0; i < G_N_ELEMENTS(directories); i++) {
+        g_autofree char *path = g_strdup_printf("%s/%s", directories[i], name);
+
+        if (virFileExists(path))
+            return g_steal_pointer(&path);
+    }
+
+    return g_strdup_printf("%s/libvirt/%s", SYSCONFDIR, name);
+}
+
 static char *
 virConfLoadConfigPath(const char *name)
 {
     char *path;
     if (geteuid() == 0) {
-        path = g_strdup_printf("%s/libvirt/%s", SYSCONFDIR, name);
+        path = virConfFindSystemConfig(name);
     } else {
         g_autofree char *userdir = virGetUserConfigDirectory();
 
