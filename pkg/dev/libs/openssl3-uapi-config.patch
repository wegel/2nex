From: Package maintainers <packages@localhost>
Subject: [PATCH] select OpenSSL configuration from UAPI paths
Source: downstream
Upstream: not submitted; needs agreement on Unix vendor and transient paths

Keep OPENSSL_CONF and CTLOG_FILE as explicit overrides. Without an override,
select each complete configuration file from the administrator path, the
transient path, or the vendor path. An existing empty or unreadable
higher-priority file remains selected and therefore masks lower files.

diff --git a/crypto/conf/conf_mod.c b/crypto/conf/conf_mod.c
--- a/crypto/conf/conf_mod.c
+++ b/crypto/conf/conf_mod.c
@@ -13,2 +13,5 @@
 #include "internal/cryptlib.h"
+#ifdef OPENSSL_SYS_UNIX
+# include <sys/stat.h>
+#endif
 #include "internal/rcu.h"
@@ -670,28 +673,64 @@ void CONF_module_set_usr_data(CONF_MODULE *pmod, void *usr_data)
     pmod->usr_data = usr_data;
 }
 
-/* Return default config file name */
-char *CONF_get1_default_config_file(void)
+char *ossl_config_file_select(const char *environment, const char *filename)
 {
-    const char *t;
-    char *file, *sep = "";
+    char *file;
     size_t size;
 
-    if ((file = ossl_safe_getenv("OPENSSL_CONF")) != NULL)
+    if ((file = ossl_safe_getenv(environment)) != NULL)
         return OPENSSL_strdup(file);
 
+#ifdef OPENSSL_SYS_UNIX
+    {
+        static const char *const dirs[] = {
+            OPENSSLDIR,
+            "/run/ssl",
+            "/usr/lib/ssl",
+        };
+        struct stat st;
+        size_t i;
+
+        for (i = 0; i < OSSL_NELEM(dirs); i++) {
+            size = strlen(dirs[i]) + 1 + strlen(filename) + 1;
+            file = OPENSSL_malloc(size);
+            if (file == NULL)
+                return NULL;
+            BIO_snprintf(file, size, "%s/%s", dirs[i], filename);
+
+            if (i == OSSL_NELEM(dirs) - 1
+                    || stat(file, &st) == 0
+                    || (errno != ENOENT && errno != ENOTDIR))
+                return file;
+
+            OPENSSL_free(file);
+        }
+
+        return NULL;
+    }
+#else
+    const char *t;
+    const char *sep = "";
+
     t = X509_get_default_cert_area();
 #ifndef OPENSSL_SYS_VMS
     sep = "/";
 #endif
-    size = strlen(t) + strlen(sep) + strlen(OPENSSL_CONF) + 1;
+    size = strlen(t) + strlen(sep) + strlen(filename) + 1;
     file = OPENSSL_malloc(size);
 
     if (file == NULL)
         return NULL;
-    BIO_snprintf(file, size, "%s%s%s", t, sep, OPENSSL_CONF);
+    BIO_snprintf(file, size, "%s%s%s", t, sep, filename);
 
     return file;
+#endif
+}
+
+/* Return default config file name */
+char *CONF_get1_default_config_file(void)
+{
+    return ossl_config_file_select("OPENSSL_CONF", OPENSSL_CONF);
 }
 
