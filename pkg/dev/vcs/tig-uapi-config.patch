@@ -1115,0 +1116,20 @@
+static enum status_code
+load_system_option_file(void)
+{
+	static const char *paths[] = {
+		"/etc/tigrc",
+		"/run/tigrc",
+		"/usr/lib/tigrc",
+	};
+	enum status_code status;
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(paths); i++) {
+		status = load_option_file(paths[i]);
+		if (status != ERROR_FILE_DOES_NOT_EXIST)
+			return status;
+	}
+
+	return ERROR_FILE_DOES_NOT_EXIST;
+}
