 namespace fs = std::filesystem;

+namespace {
+
+void addConfigDir(std::vector<std::string>& dirs, const fs::path& path) {
+  const auto value = path.lexically_normal().string();
+  if (std::find(dirs.begin(), dirs.end(), value) == dirs.end()) {
+    dirs.emplace_back(value);
+  }
+}
+
+bool addAbsoluteConfigDir(std::vector<std::string>& dirs, const char* base) {
+  if (base == nullptr || *base == '\0') {
+    return false;
+  }
+
+  const fs::path path(base);
+  if (!path.is_absolute()) {
+    return false;
+  }
+
+  addConfigDir(dirs, path / "waybar");
+  return true;
+}
+
+}  // namespace
