diff --git a/test/config-paths.cpp b/test/config-paths.cpp
new file mode 100644
index 0000000..6aa6289
--- /dev/null
+++ b/test/config-paths.cpp
@@ -0,0 +1,139 @@
+#include "config.hpp"
+
+#include <unistd.h>
+
+#include <algorithm>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <string>
+#include <vector>
+
+namespace fs = std::filesystem;
+
+namespace {
+
+bool expectEqual(const std::string& label, const std::string& actual,
+                 const std::string& expected) {
+  if (actual == expected) {
+    return true;
+  }
+  std::cerr << label << ": expected " << expected << ", got " << actual << '\n';
+  return false;
+}
+
+void writeConfig(const fs::path& directory) {
+  fs::create_directories(directory);
+  std::ofstream(directory / "config.jsonc") << "{}\n";
+}
+
+}  // namespace
+
+int main() {
+  const fs::path base =
+      fs::temp_directory_path() / ("waybar-config-paths-" + std::to_string(getpid()));
+  fs::remove_all(base);
+
+  const fs::path home = base / "home";
+  const fs::path user = base / "user";
+  const fs::path system_a = base / "system-a";
+  const fs::path system_b = base / "system-b";
+  const fs::path custom = base / "custom";
+
+  setenv("HOME", home.c_str(), 1);
+  setenv("XDG_CONFIG_HOME", user.c_str(), 1);
+  const std::string system_dirs = system_a.string() + ":relative:" + system_b.string();
+  setenv("XDG_CONFIG_DIRS", system_dirs.c_str(), 1);
+  setenv("WAYBAR_CONFIG_DIR", custom.c_str(), 1);
+
+  const std::vector<std::string> expected_dirs = {
+      (user / "waybar").string(),
+      (home / "waybar").string(),
+      (system_a / "waybar").string(),
+      (system_b / "waybar").string(),
+      "/run/xdg/waybar",
+      WAYBAR_VENDOR_CONFIG_DIR,
+      "./resources/",
+  };
+  const auto dirs = waybar::Config::getConfigDirs();
+  if (dirs != expected_dirs) {
+    std::cerr << "unexpected configuration directory order\n";
+    fs::remove_all(base);
+    return 1;
+  }
+
+  const std::vector<fs::path> writable_layers = {
+      custom,
+      user / "waybar",
+      home / "waybar",
+      system_a / "waybar",
+      system_b / "waybar",
+  };
+  for (const auto& layer : writable_layers) {
+    writeConfig(layer);
+  }
+
+  for (const auto& expected : writable_layers) {
+    const auto selected = waybar::Config::findConfigPath({"config", "config.jsonc"});
+    if (!selected ||
+        !expectEqual("selected configuration", *selected, (expected / "config.jsonc").string())) {
+      fs::remove_all(base);
+      return 1;
+    }
+    fs::remove(expected / "config.jsonc");
+    if (expected == custom) {
+      unsetenv("WAYBAR_CONFIG_DIR");
+    }
+  }
+
+  const fs::path transient = base / "run";
+  const fs::path vendor = base / "vendor";
+  const std::vector<std::string> machine_dirs = {
+      (system_a / "waybar").string(),
+      transient.string(),
+      vendor.string(),
+  };
+
+  writeConfig(vendor);
+  auto selected = waybar::Config::findConfigPath({"config.jsonc"}, machine_dirs);
+  if (!selected ||
+      !expectEqual("vendor configuration", *selected, (vendor / "config.jsonc").string())) {
+    fs::remove_all(base);
+    return 1;
+  }
+
+  writeConfig(transient);
+  selected = waybar::Config::findConfigPath({"config.jsonc"}, machine_dirs);
+  if (!selected ||
+      !expectEqual("transient configuration", *selected,
+                   (transient / "config.jsonc").string())) {
+    fs::remove_all(base);
+    return 1;
+  }
+
+  writeConfig(system_a / "waybar");
+  const fs::path administrator_file = system_a / "waybar/config.jsonc";
+  std::ofstream(administrator_file, std::ios::trunc);
+  selected = waybar::Config::findConfigPath({"config.jsonc"}, machine_dirs);
+  if (!selected || !expectEqual("empty administrator mask", *selected,
+                                administrator_file.string())) {
+    fs::remove_all(base);
+    return 1;
+  }
+
+  setenv("XDG_CONFIG_HOME", "", 1);
+  setenv("XDG_CONFIG_DIRS", "", 1);
+  const auto fallback_dirs = waybar::Config::getConfigDirs();
+  if (fallback_dirs.empty() ||
+      !expectEqual("default user directory", fallback_dirs.front(),
+                   (home / ".config/waybar").string()) ||
+      std::find(fallback_dirs.begin(), fallback_dirs.end(), "/etc/xdg/waybar") ==
+          fallback_dirs.end()) {
+    fs::remove_all(base);
+    return 1;
+  }
+
+  fs::remove_all(base);
+  return 0;
+}
