 const char* Config::CONFIG_PATH_ENV = "WAYBAR_CONFIG_DIR";

+std::vector<std::string> Config::getConfigDirs() {
+  std::vector<std::string> dirs;
+
+  if (!addAbsoluteConfigDir(dirs, std::getenv("XDG_CONFIG_HOME"))) {
+    if (const char* home = std::getenv("HOME"); home != nullptr && *home != '\0') {
+      const fs::path home_path(home);
+      if (home_path.is_absolute()) {
+        addConfigDir(dirs, home_path / ".config/waybar");
+      }
+    }
+  }
+
+  if (const char* home = std::getenv("HOME"); home != nullptr && *home != '\0') {
+    const fs::path home_path(home);
+    if (home_path.is_absolute()) {
+      addConfigDir(dirs, home_path / "waybar");
+    }
+  }
+
+  const char* xdg_config_dirs = std::getenv("XDG_CONFIG_DIRS");
+  const std::string system_dirs =
+      xdg_config_dirs == nullptr || *xdg_config_dirs == '\0' ? "/etc/xdg" : xdg_config_dirs;
+  std::stringstream stream(system_dirs);
+  std::string system_dir;
+  while (std::getline(stream, system_dir, ':')) {
+    addAbsoluteConfigDir(dirs, system_dir.c_str());
+  }
+
+  addConfigDir(dirs, "/run/xdg/waybar");
+  addConfigDir(dirs, WAYBAR_VENDOR_CONFIG_DIR);
+  dirs.emplace_back("./resources/");
+  return dirs;
+}
