@@ -0,0 +1,46 @@
+namespace SwayNotificationCenter {
+    public class ConfigPaths {
+        private ConfigPaths () {}
+
+        public static string[] build_search_paths (
+                owned string ? custom_path,
+                bool include_user,
+                string relative_path,
+                string user_config_dir,
+                string[] system_config_dirs,
+                string runtime_config_dir,
+                string vendor_config_dir) {
+            string[] paths = {};
+
+            if (custom_path != null &&
+                    (custom_path = custom_path.strip ()).length > 0) {
+                if (custom_path.get (0) == '~') {
+                    custom_path = Environment.get_home_dir () + custom_path[1:];
+                }
+                paths += custom_path;
+            }
+
+            if (include_user) {
+                paths += Path.build_path (Path.DIR_SEPARATOR.to_string (),
+                                          user_config_dir, relative_path);
+            }
+            foreach (unowned string path in system_config_dirs) {
+                paths += Path.build_path (Path.DIR_SEPARATOR.to_string (),
+                                          path, relative_path);
+            }
+            paths += Path.build_path (Path.DIR_SEPARATOR.to_string (),
+                                      runtime_config_dir, relative_path);
+            paths += Path.build_path (Path.DIR_SEPARATOR.to_string (),
+                                      vendor_config_dir, relative_path);
+
+            return paths;
+        }
+
+        public static string ? find_first_existing (string[] paths) {
+            foreach (unowned string path in paths) {
+                if (File.new_for_path (path).query_exists ()) return path;
+            }
+            return null;
+        }
+    }
+}
