@@ -0,0 +1,52 @@
+using SwayNotificationCenter;
+
+private void write_file (string path) throws FileError {
+    DirUtils.create_with_parents (Path.get_dirname (path), 0700);
+    FileUtils.set_contents (path, "{}");
+}
+
+private void test_priority () {
+    try {
+        string root = DirUtils.make_tmp ("swaync-config-paths-XXXXXX");
+        string custom = Path.build_filename (root, "custom.json");
+        string user = Path.build_filename (root, "user");
+        string admin_first = Path.build_filename (root, "admin-first");
+        string admin_second = Path.build_filename (root, "admin-second");
+        string runtime = Path.build_filename (root, "runtime");
+        string vendor = Path.build_filename (root, "vendor");
+        string[] system_dirs = { admin_first, admin_second };
+        string[] paths = ConfigPaths.build_search_paths (
+            custom, true, "swaync/config.json", user, system_dirs,
+            runtime, vendor);
+
+        assert (paths.length == 6);
+        assert (paths[0] == custom);
+        assert (paths[1] == Path.build_filename (user, "swaync/config.json"));
+        assert (paths[2] == Path.build_filename (admin_first, "swaync/config.json"));
+        assert (paths[3] == Path.build_filename (admin_second, "swaync/config.json"));
+        assert (paths[4] == Path.build_filename (runtime, "swaync/config.json"));
+        assert (paths[5] == Path.build_filename (vendor, "swaync/config.json"));
+
+        write_file (paths[5]);
+        assert (ConfigPaths.find_first_existing (paths) == paths[5]);
+        write_file (paths[4]);
+        assert (ConfigPaths.find_first_existing (paths) == paths[4]);
+        write_file (paths[3]);
+        assert (ConfigPaths.find_first_existing (paths) == paths[3]);
+        write_file (paths[2]);
+        assert (ConfigPaths.find_first_existing (paths) == paths[2]);
+        write_file (paths[1]);
+        assert (ConfigPaths.find_first_existing (paths) == paths[1]);
+        write_file (paths[0]);
+        assert (ConfigPaths.find_first_existing (paths) == paths[0]);
+    } catch (FileError e) {
+        Test.fail ();
+        critical ("Could not create test files: %s", e.message);
+    }
+}
+
+public int main (string[] args) {
+    Test.init (ref args);
+    Test.add_func ("/config-paths/priority", test_priority);
+    return Test.run ();
+}
