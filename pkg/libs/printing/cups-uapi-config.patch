+/*
+ * 'select_snmp_file()' - Select the SNMP configuration file.
+ */
+
+static void
+select_snmp_file(char   *filename,
+                 size_t filenamesize)
+{
+  static const char * const directories[] =
+  {
+    "/etc/cups",
+    "/run/cups",
+    "/usr/lib/cups"
+  };
+  const char *cups_serverroot;
+  size_t i;
+
+
+  if ((cups_serverroot = getenv("CUPS_SERVERROOT")) != NULL)
+  {
+    snprintf(filename, filenamesize, "%s/snmp.conf", cups_serverroot);
+    return;
+  }
+
+  for (i = 0; i < sizeof(directories) / sizeof(directories[0]); i ++)
+  {
+    snprintf(filename, filenamesize, "%s/snmp.conf", directories[i]);
+
+    if (!access(filename, F_OK))
+      return;
