Subject: select CUPS system configuration from UAPI directories
Source: Nex downstream patch for CUPS 2.4.7
Upstream: not submitted; needs agreement on Unix vendor and transient paths

Select the scheduler's two complete configuration files and both SNMP readers
from /etc, /run, or /usr/lib. Preserve explicit command-line and environment
paths, including CUPS's privilege checks. Empty higher files deliberately mask
lower defaults.

--- a/scheduler/main.c
+++ b/scheduler/main.c
@@ -71,0 +72 @@
+static void		select_system_file(char **file, const char *name);
@@ -171,0 +173,3 @@
+	      if (*opt == 'c')
+	        ConfigurationFileExplicit = 1;
+
@@ -222,0 +227,4 @@
+          case 'E' : /* Preserve an explicit config across the child exec */
+	      ConfigurationFileExplicit = 1;
+	      break;
+
@@ -327 +335,6 @@
-    cupsdSetString(&ConfigurationFile, CUPS_SERVERROOT "/cupsd.conf");
+  {
+    select_system_file(&ConfigurationFile, "cupsd.conf");
+
+    if (!CupsFilesFile)
+      select_system_file(&CupsFilesFile, "cups-files.conf");
+  }
@@ -493 +506,4 @@
-    execlp(argv[0], argv[0], "-C", ConfigurationFile, "-s", CupsFilesFile, (char *)0);
+    if (ConfigurationFileExplicit)
+      execlp(argv[0], argv[0], "-C", ConfigurationFile, "-s", CupsFilesFile, "-E", (char *)0);
+    else
+      execlp(argv[0], argv[0], "-C", ConfigurationFile, "-s", CupsFilesFile, (char *)0);
@@ -1206,0 +1223,27 @@
+}
+
+
+/*
+ * 'select_system_file()' - Select an administrator, transient, or vendor file.
+ */
+
+static void
+select_system_file(char       **file,
+                   const char *name)
+{
+  static const char * const directories[] =
+  {
+    "/etc/cups",
+    "/run/cups",
+    "/usr/lib/cups"
+  };
+  size_t i;
+
+
+  for (i = 0; i < sizeof(directories) / sizeof(directories[0]); i ++)
+  {
+    cupsdSetStringf(file, "%s/%s", directories[i], name);
+
+    if (!access(*file, F_OK))
+      return;
+  }
