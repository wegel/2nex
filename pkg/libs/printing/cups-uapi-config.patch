+/*
+ * '_cupsSystemConfigFile()' - Select an administrator, transient, or vendor file.
+ *
+ * An explicit CUPS_SERVERROOT keeps its exact meaning. Otherwise the first
+ * existing file among /etc/cups, /run/cups, and /usr/lib/cups wins outright,
+ * so an empty administrator file masks the lower tiers.
+ */
+
+void
+_cupsSystemConfigFile(
+    _cups_globals_t *cg,		/* I - Global data */
+    const char      *name,		/* I - Configuration file name */
+    char            *buffer,		/* I - Filename buffer */
+    size_t          bufsize)		/* I - Size of filename buffer */
+{
+  static const char * const directories[] =
+  {
+    "/etc/cups",
+    "/run/cups",
+    "/usr/lib/cups"
+  };
+  size_t i;				/* Looping var */
+
+
+  if (cg->cups_serverroot_explicit)
+  {
+    snprintf(buffer, bufsize, "%s/%s", cg->cups_serverroot, name);
+    return;
+  }
+
+  for (i = 0; i < sizeof(directories) / sizeof(directories[0]); i ++)
+  {
+    snprintf(buffer, bufsize, "%s/%s", directories[i], name);
+
+    if (!access(buffer, F_OK))
+      return;
+  }
+
+  snprintf(buffer, bufsize, "%s/%s", cg->cups_serverroot, name);
+}
