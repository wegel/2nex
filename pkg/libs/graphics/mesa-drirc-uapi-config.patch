+/*
+ * Smoke check for the merged UAPI drirc.d and drirc reader in xmlconfig.c.
+ *
+ * This program only calls the real driParseOptionInfo/driParseConfigFiles
+ * API; it does not reimplement the selection algorithm. The build script
+ * that invokes it creates and removes the drirc fixture files between
+ * invocations and asserts on the printed option values.
+ */
+
+#include <stdio.h>
+#include <driconf.h>
+#include <xmlconfig.h>
+
+int
+main(void)
+{
+   driInjectExecName("smoke-app");
+
+   driOptionDescription driconf[] = {
+      DRI_CONF_SECTION_MISCELLANEOUS
+      DRI_CONF_OPT_I(smoke_vendor, -1, -1, 999, "vendor tier option")
+      DRI_CONF_OPT_I(smoke_run, -1, -1, 999, "runtime tier option")
+      DRI_CONF_OPT_I(smoke_etc, -1, -1, 999, "administrator tier option")
+      DRI_CONF_OPT_I(smoke_shared, -1, -1, 999, "shared basename option")
+      DRI_CONF_OPT_I(smoke_lower_only, -1, -1, 999, "lower-only option")
+      DRI_CONF_OPT_I(smoke_alpha, -1, -1, 999, "distinct basename a")
+      DRI_CONF_OPT_I(smoke_zeta, -1, -1, 999, "distinct basename z")
+      DRI_CONF_OPT_I(smoke_order, -1, -1, 999, "global filename order option")
+      DRI_CONF_OPT_I(smoke_main, -1, -1, 999, "main file option")
+      DRI_CONF_OPT_I(smoke_home, -1, -1, 999, "home file option")
+      DRI_CONF_OPT_I(smoke_configdir, -1, -1, 999, "DRIRC_CONFIGDIR option")
+      DRI_CONF_OPT_I(smoke_env, -1, -1, 999, "process environment option")
+   };
+   unsigned num_options = sizeof(driconf) / sizeof(driconf[0]);
+
+   driOptionCache info = {0};
+   driParseOptionInfo(&info, driconf, num_options);
+
+   driOptionCache cache;
+   driParseConfigFiles(&cache, &info, 0, "smoke", "smoke", NULL,
+                       NULL, 0, NULL, 0);
+
+   printf("%d %d %d %d %d %d %d %d %d %d %d %d\n",
+          driQueryOptioni(&cache, "smoke_vendor"),
+          driQueryOptioni(&cache, "smoke_run"),
+          driQueryOptioni(&cache, "smoke_etc"),
+          driQueryOptioni(&cache, "smoke_shared"),
+          driQueryOptioni(&cache, "smoke_lower_only"),
+          driQueryOptioni(&cache, "smoke_alpha"),
+          driQueryOptioni(&cache, "smoke_zeta"),
+          driQueryOptioni(&cache, "smoke_order"),
+          driQueryOptioni(&cache, "smoke_main"),
+          driQueryOptioni(&cache, "smoke_home"),
+          driQueryOptioni(&cache, "smoke_configdir"),
+          driQueryOptioni(&cache, "smoke_env"));
+
+   driDestroyOptionCache(&cache);
+   driDestroyOptionInfo(&info);
+   return 0;
+}
