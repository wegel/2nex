From: Package maintainers <packages@localhost>
Subject: [PATCH] layer the multipress input-method data
Source: downstream
Upstream: not submitted; suitable for upstream review

Read a lasting administrator file before a transient machine file and the
packaged input-method data. An existing empty higher-priority file masks the
lower data because the selected file is the only one parsed.

Also fix the settings.ini priority. gtk_settings_init() loads every file with
the same source, so a later file overwrites an earlier one and load order alone
decides priority. It walked XDG_CONFIG_DIRS forward, but that variable lists
its highest-priority directory first, so a transient or vendor entry later in
the list overrode the administrator entry ahead of it. Walk the list backwards
and load the system configuration directory afterwards, so administrator
settings stay above both the vendor prefix and the directory list.

diff -urN a/gtk/gtksettings.c b/gtk/gtksettings.c
--- a/gtk/gtksettings.c
+++ b/gtk/gtksettings.c
@@ -347,13 +347,17 @@
     gtk_settings_load_from_key_file (settings, path, GTK_SETTINGS_SOURCE_DEFAULT);
   g_free (path);
 
-  path = g_build_filename (_gtk_get_sysconfdir (), "gtk-3.0", "settings.ini", NULL);
-  if (g_file_test (path, G_FILE_TEST_EXISTS))
-    gtk_settings_load_from_key_file (settings, path, GTK_SETTINGS_SOURCE_DEFAULT);
-  g_free (path);
-
+  /*
+   * Every file here is loaded with the same source, so a later file overwrites
+   * an earlier one and load order alone decides priority. XDG_CONFIG_DIRS
+   * lists its highest-priority directory first, so walk it backwards, and load
+   * the system configuration directory afterwards so administrator settings
+   * stay above both the vendor prefix and the directory list.
+   */
   config_dirs = g_get_system_config_dirs ();
   for (i = 0; config_dirs[i] != NULL; i++)
+    ;
+  while (i-- > 0)
     {
       path = g_build_filename (config_dirs[i], "gtk-3.0", "settings.ini", NULL);
       if (g_file_test (path, G_FILE_TEST_EXISTS))
@@ -361,6 +365,11 @@
       g_free (path);
     }
 
+  path = g_build_filename (_gtk_get_sysconfdir (), "gtk-3.0", "settings.ini", NULL);
+  if (g_file_test (path, G_FILE_TEST_EXISTS))
+    gtk_settings_load_from_key_file (settings, path, GTK_SETTINGS_SOURCE_DEFAULT);
+  g_free (path);
+
   path = g_build_filename (g_get_user_config_dir (), "gtk-3.0", "settings.ini", NULL);
   if (g_file_test (path, G_FILE_TEST_EXISTS))
     gtk_settings_load_from_key_file (settings, path, GTK_SETTINGS_SOURCE_DEFAULT);
