+static int khrIcdOsDirCollect(const char *path, const char *extension,
+                              struct dirElem **dirElems, size_t *elemCount)
+{
+    DIR *dir = opendir(path);
+    struct dirent *dirEntry;
+    size_t extensionSize = strlen(extension);
+
+    if (!dir)
+    {
+        KHR_ICD_TRACE("Failed to open path %s, continuing\n", path);
+        return 1;
+    }
+
+    while ((dirEntry = readdir(dir)) != NULL)
+    {
+        size_t nameSize = strlen(dirEntry->d_name);
+
+        if (extensionSize > nameSize ||
+            strcmp(dirEntry->d_name + nameSize - extensionSize, extension) ||
+            khrIcdOsDirElemExists(*dirElems, *elemCount, dirEntry->d_name))
+        {
+            continue;
+        }
+
+        if (!khrIcdOsDirElemAdd(dirElems, elemCount, dirEntry->d_name, path))
+        {
+            KHR_ICD_TRACE("Failed to collect configuration from %s\n", path);
+            closedir(dir);
+            return 0;
+        }
+    }
+
+    closedir(dir);
+    return 1;
+}
+
+static inline void khrIcdOsDirEnumerate(const char * const *paths,
+                                        size_t pathCount, const char *env,
+                                        const char *extension,
+                                        khrIcdFileAdd addFunc)
+{
+    struct dirElem *dirElems = NULL;
+    size_t elemCount = 0;
+    char *envPath = khrIcd_secure_getenv(env);
+    size_t i;
+
+    if (envPath)
+    {
+        khrIcdOsDirCollect(envPath, extension, &dirElems, &elemCount);
+    }
+    else
+    {
+        for (i = 0; i < pathCount; i++)
+        {
+            if (!khrIcdOsDirCollect(paths[i], extension, &dirElems, &elemCount))
+            {
+                break;
+            }
+        }
+    }
+
+    if (elemCount > 1)
+    {
+        qsort(dirElems, elemCount, sizeof(struct dirElem), compareDirElem);
+    }
+
+    for (i = 0; i < elemCount; i++)
+    {
+        khrIcdOsDirEntryValidateAndAdd(dirElems[i].d_name, dirElems[i].path,
+                                       extension, addFunc);
+        free(dirElems[i].d_name);
+        free(dirElems[i].path);
+    }
+    free(dirElems);
+
+    if (envPath)
+    {
+        khrIcd_free_getenv(envPath);
+    }
 }
 
