+
+struct config_case {
+    const char *name;
+    const char *local;
+    const char *env;
+};
+
+static void make_directory(const char *path) {
+    char *copy, *p;
+
+    copy = strdup(path);
+    assert(copy);
+
+    for (p = copy + 1; *p; p++) {
+        if (*p != '/')
+            continue;
+
+        *p = '\0';
+        assert(mkdir(copy, 0700) == 0 || errno == EEXIST);
+        *p = '/';
+    }
+
+    assert(mkdir(copy, 0700) == 0 || errno == EEXIST);
+    free(copy);
+}
+
+static void write_file(const char *path, const char *contents) {
+    FILE *f;
+
+    f = fopen(path, "w");
+    assert(f);
+    assert(fputs(contents, f) >= 0);
+    assert(fclose(f) == 0);
+}
+
+static void assert_selected(const struct config_case *test, const char *expected_path,
+                            const char *expected_contents) {
+    char contents[128] = "";
+    char *path = NULL;
+    FILE *f;
+
+    f = pa_open_layered_config_file(test->name, test->local, test->env, &path);
+    assert(f);
+    assert(path);
+    assert(strcmp(path, expected_path) == 0);
+
+    if (expected_contents[0]) {
+        assert(fgets(contents, sizeof(contents), f));
+        assert(strcmp(contents, expected_contents) == 0);
+    } else
+        assert(fgetc(f) == EOF);
+
+    fclose(f);
+    pa_xfree(path);
+
+    path = pa_find_layered_config_file(test->name, test->local, test->env);
+    assert(path);
+    assert(strcmp(path, expected_path) == 0);
+    pa_xfree(path);
+}
+
+static void assert_missing(const struct config_case *test) {
+    char *path = NULL;
+
+    assert(!pa_open_layered_config_file(test->name, test->local, test->env, &path));
+    assert(!path);
+    assert(!pa_find_layered_config_file(test->name, test->local, test->env));
+}
+
+static void test_main_files(void) {
+    const struct config_case tests[] = {
+        { "client.conf", "client.conf", "PULSE_CLIENTCONFIG" },
+        { "daemon.conf", "/daemon.conf", "PULSE_CONFIG" },
+        { "default.pa", "/default.pa", "PULSE_SCRIPT" },
+        { "system.pa", NULL, "PULSE_SCRIPT" },
+    };
+    size_t i;
+
+    for (i = 0; i < PA_ELEMENTSOF(tests); i++) {
+        char admin[128], runtime[128], vendor[128];
+
+        assert(snprintf(admin, sizeof(admin), "/etc/pulse/%s", tests[i].name) > 0);
+        assert(snprintf(runtime, sizeof(runtime), "/run/pulse/%s", tests[i].name) > 0);
+        assert(snprintf(vendor, sizeof(vendor), "/usr/lib/pulse/%s", tests[i].name) > 0);
+
+        write_file(vendor, "vendor");
+        assert_selected(&tests[i], vendor, "vendor");
+
+        write_file(runtime, "runtime");
+        assert_selected(&tests[i], runtime, "runtime");
+
+        write_file(admin, "");
+        assert_selected(&tests[i], admin, "");
+
+        assert(unlink(admin) == 0);
+        assert(unlink(runtime) == 0);
+        assert(unlink(vendor) == 0);
+    }
+}
+
+static void test_user_and_environment_paths(void) {
+    const struct config_case client = { "client.conf", "client.conf", "PULSE_CLIENTCONFIG" };
+    const struct config_case tests[] = {
+        { "client.conf", "client.conf", "PULSE_CLIENTCONFIG" },
+        { "daemon.conf", "/daemon.conf", "PULSE_CONFIG" },
+        { "default.pa", "/default.pa", "PULSE_SCRIPT" },
+        { "system.pa", NULL, "PULSE_SCRIPT" },
+    };
+    size_t i;
+
+    write_file("/usr/lib/pulse/client.conf", "vendor");
+    write_file("/home/test/.config/pulse/client.conf", "modern-user");
+    assert_selected(&client, "/home/test/.config/pulse/client.conf", "modern-user");
+
+    write_file("/home/test/.pulse/client.conf", "legacy-user");
+    assert_selected(&client, "/home/test/.pulse/client.conf", "legacy-user");
+
+    write_file("/custom/client.conf", "config-path");
+    assert(setenv("PULSE_CONFIG_PATH", "/custom", 1) == 0);
+    assert_selected(&client, "/custom/client.conf", "config-path");
+    assert(unsetenv("PULSE_CONFIG_PATH") == 0);
+
+    assert(unlink("/home/test/.pulse/client.conf") == 0);
+    assert(unlink("/home/test/.config/pulse/client.conf") == 0);
+    assert(unlink("/custom/client.conf") == 0);
+    assert(unlink("/usr/lib/pulse/client.conf") == 0);
+
+    for (i = 0; i < PA_ELEMENTSOF(tests); i++) {
+        char explicit_path[128], vendor_path[128];
+
+        assert(snprintf(explicit_path, sizeof(explicit_path), "/explicit/%s", tests[i].name) > 0);
+        assert(snprintf(vendor_path, sizeof(vendor_path), "/usr/lib/pulse/%s", tests[i].name) > 0);
+        write_file(vendor_path, "vendor");
+        write_file(explicit_path, "explicit");
+
+        assert(setenv(tests[i].env, explicit_path, 1) == 0);
+        assert_selected(&tests[i], explicit_path, "explicit");
+        assert(unlink(explicit_path) == 0);
+        assert_missing(&tests[i]);
+        assert(unsetenv(tests[i].env) == 0);
+        assert(unlink(vendor_path) == 0);
+    }
+}
+
+static void test_layered_drop_ins(void) {
+    const struct config_case client = { "client.conf", "client.conf", "PULSE_CLIENTCONFIG" };
+    pa_config_item table[] = {
+        { "order", pa_config_parse_string, NULL, NULL },
+        { "shadow", pa_config_parse_string, NULL, NULL },
+        { "empty", pa_config_parse_string, NULL, NULL },
+        { "nullmask", pa_config_parse_string, NULL, NULL },
+        { NULL, NULL, NULL, NULL },
+    };
+    char *order = NULL, *shadow = NULL, *empty = NULL, *nullmask = NULL;
+    char *path = NULL;
+    FILE *f;
+
+    table[0].data = &order;
+    table[1].data = &shadow;
+    table[2].data = &empty;
+    table[3].data = &nullmask;
+
+    make_directory("/usr/lib/pulse/client.conf.d");
+    make_directory("/run/pulse/client.conf.d");
+    make_directory("/etc/pulse/client.conf.d");
+    make_directory("/home/test/.config/pulse/client.conf.d");
+
+    write_file("/usr/lib/pulse/client.conf",
+               "order=main\nshadow=main\nempty=main\nnullmask=main\n");
+    write_file("/usr/lib/pulse/client.conf.d/10-order.conf", "order=10\n");
+    write_file("/usr/lib/pulse/client.conf.d/90-order.conf", "order=90\n");
+    write_file("/usr/lib/pulse/client.conf.d/20-shadow.conf", "shadow=vendor\n");
+    write_file("/run/pulse/client.conf.d/20-shadow.conf", "shadow=runtime\n");
+    write_file("/etc/pulse/client.conf.d/20-shadow.conf", "shadow=admin\n");
+    write_file("/home/test/.config/pulse/client.conf.d/20-shadow.conf", "shadow=user\n");
+    write_file("/usr/lib/pulse/client.conf.d/30-empty.conf", "empty=vendor\n");
+    write_file("/etc/pulse/client.conf.d/30-empty.conf", "");
+    write_file("/usr/lib/pulse/client.conf.d/40-null.conf", "nullmask=vendor\n");
+    assert(symlink("/dev/null", "/run/pulse/client.conf.d/40-null.conf") == 0);
+
+    f = pa_open_layered_config_file(client.name, client.local, client.env, &path);
+    assert(f);
+    assert(pa_config_parse_layered(path, f, table, NULL, client.name, client.local, client.env, NULL) == 0);
+    fclose(f);
+    pa_xfree(path);
+
+    assert(strcmp(order, "90") == 0);
+    assert(strcmp(shadow, "user") == 0);
+    assert(strcmp(empty, "main") == 0);
+    assert(strcmp(nullmask, "main") == 0);
+    pa_xfree(order);
+    pa_xfree(shadow);
+    pa_xfree(empty);
+    pa_xfree(nullmask);
+
+    order = shadow = empty = nullmask = NULL;
+    make_directory("/explicit/client.conf.d");
+    write_file("/explicit/client.conf", "order=explicit-main\n");
+    write_file("/explicit/client.conf.d/10-explicit.conf", "order=explicit-drop-in\n");
+    write_file("/etc/pulse/client.conf.d/99-system.conf", "order=system\n");
+    assert(setenv("PULSE_CLIENTCONFIG", "/explicit/client.conf", 1) == 0);
+
+    f = pa_open_layered_config_file(client.name, client.local, client.env, &path);
+    assert(f);
+    assert(pa_config_parse_layered(path, f, table, NULL, client.name, client.local, client.env, NULL) == 0);
+    fclose(f);
+    pa_xfree(path);
+    assert(strcmp(order, "explicit-drop-in") == 0);
+    assert(!shadow && !empty && !nullmask);
+    pa_xfree(order);
+    assert(unsetenv("PULSE_CLIENTCONFIG") == 0);
+}
+
+int main(void) {
+    char root[] = "/tmp/pulse-layered-config-XXXXXX";
+
+    assert(mkdtemp(root));
+    assert(chroot(root) == 0);
+    assert(chdir("/") == 0);
+
+    make_directory("/etc/pulse");
+    make_directory("/dev");
+    make_directory("/run/pulse");
+    make_directory("/usr/lib/pulse");
+    make_directory("/home/test/.config/pulse");
+    make_directory("/home/test/.pulse");
+    make_directory("/custom");
+    make_directory("/explicit");
+    write_file("/dev/null", "");
+    assert(setenv("HOME", "/home/test", 1) == 0);
+
+    test_main_files();
+    test_user_and_environment_paths();
+    test_layered_drop_ins();
+    return 0;
+}
