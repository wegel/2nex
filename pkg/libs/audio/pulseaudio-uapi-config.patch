 static int conf_filter(const struct dirent *entry) {
     return pa_endswith(entry->d_name, ".conf");
 }
+
+struct layered_drop_in {
+    char *name;
+    char *path;
+};
+
+static void collect_drop_ins(struct layered_drop_in **drop_ins, size_t *n_drop_ins,
+                             const char *directory, const char *name) {
+    char *drop_in_directory;
+    struct dirent **entries = NULL;
+    int n, i;
+
+    drop_in_directory = pa_sprintf_malloc("%s" PA_PATH_SEP "%s.d", directory, name);
+    n = scandir(drop_in_directory, &entries, conf_filter, alphasort);
+    if (n < 0) {
+        if (errno != ENOENT)
+            pa_log_warn("scandir(\"%s\") failed: %s", drop_in_directory, pa_cstrerror(errno));
+        pa_xfree(drop_in_directory);
+        return;
+    }
+
+    for (i = 0; i < n; i++) {
+        char *path;
+        size_t j;
+
+        path = pa_sprintf_malloc("%s" PA_PATH_SEP "%s", drop_in_directory, entries[i]->d_name);
+        for (j = 0; j < *n_drop_ins; j++)
+            if (pa_streq((*drop_ins)[j].name, entries[i]->d_name))
+                break;
+
+        if (j == *n_drop_ins) {
+            *drop_ins = pa_xrealloc(*drop_ins, sizeof(**drop_ins) * (*n_drop_ins + 1));
+            (*drop_ins)[j].name = pa_xstrdup(entries[i]->d_name);
+            (*n_drop_ins)++;
+        } else
+            pa_xfree((*drop_ins)[j].path);
+
+        (*drop_ins)[j].path = path;
+        free(entries[i]);
+    }
+
+    free(entries);
+    pa_xfree(drop_in_directory);
+}
+
+static int compare_drop_ins(const void *a, const void *b) {
+    const struct layered_drop_in *left = a;
+    const struct layered_drop_in *right = b;
+
+    return strcmp(left->name, right->name);
+}
 #endif
 
