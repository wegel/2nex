 }
 
+int pa_config_parse_layered(const char *filename, FILE *f, const pa_config_item *t, pa_proplist *proplist,
+                            const char *name, const char *local, const char *env, void *userdata) {
+#ifdef OS_IS_WIN32
+    return pa_config_parse(filename, f, t, proplist, true, userdata);
+#else
+    struct layered_drop_in *drop_ins = NULL;
+    size_t n_drop_ins = 0, i;
+    const char *config_path;
+    char *home = NULL;
+    int r;
+
+    pa_assert(name);
+
+    if (env && getenv(env))
+        return pa_config_parse(filename, f, t, proplist, true, userdata);
+
+    r = pa_config_parse(filename, f, t, proplist, false, userdata);
+    if (r < 0)
+        return r;
+
+    collect_drop_ins(&drop_ins, &n_drop_ins, PA_VENDOR_CONFIG_DIR, name);
+    collect_drop_ins(&drop_ins, &n_drop_ins, PA_RUNTIME_CONFIG_DIR, name);
+    collect_drop_ins(&drop_ins, &n_drop_ins, PA_DEFAULT_CONFIG_DIR, name);
+
+    if (local) {
+        if ((config_path = getenv("PULSE_CONFIG_PATH")))
+            collect_drop_ins(&drop_ins, &n_drop_ins, config_path, name);
+        else if ((home = pa_get_home_dir_malloc())) {
+            char *directory;
+
+            directory = pa_sprintf_malloc("%s" PA_PATH_SEP ".config" PA_PATH_SEP "pulse", home);
+            collect_drop_ins(&drop_ins, &n_drop_ins, directory, name);
+            pa_xfree(directory);
+
+            directory = pa_sprintf_malloc("%s" PA_PATH_SEP ".pulse", home);
+            collect_drop_ins(&drop_ins, &n_drop_ins, directory, name);
+            pa_xfree(directory);
+        }
+    }
+
+    if (n_drop_ins > 1)
+        qsort(drop_ins, n_drop_ins, sizeof(*drop_ins), compare_drop_ins);
+    for (i = 0; i < n_drop_ins; i++) {
+        pa_config_parse(drop_ins[i].path, NULL, t, proplist, false, userdata);
+        pa_xfree(drop_ins[i].name);
+        pa_xfree(drop_ins[i].path);
+    }
+
+    pa_xfree(home);
+    pa_xfree(drop_ins);
+    return r;
+#endif
+}
