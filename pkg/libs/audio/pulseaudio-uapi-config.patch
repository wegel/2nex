+/* Open a system configuration file according to the UAPI configuration file
+ * rules, while keeping PulseAudio's explicit and per-user paths ahead of the
+ * system paths. */
+FILE *pa_open_layered_config_file(const char *name, const char *local, const char *env, char **result) {
+#ifdef OS_IS_WIN32
+    char *global;
+    FILE *f;
+
+    global = pa_sprintf_malloc(PA_DEFAULT_CONFIG_DIR PA_PATH_SEP "%s", name);
+    f = pa_open_config_file(global, local, env, result);
+    pa_xfree(global);
+    return f;
+#else
+    const char *directories[] = {
+        PA_DEFAULT_CONFIG_DIR,
+        PA_RUNTIME_CONFIG_DIR,
+        PA_VENDOR_CONFIG_DIR,
+    };
+    FILE *f;
+    size_t i;
+
+    pa_assert(name);
+
+    if (env && getenv(env))
+        return pa_open_config_file(NULL, NULL, env, result);
+
+    if (local) {
+        f = pa_open_config_file(NULL, local, NULL, result);
+        if (f || errno != ENOENT)
+            return f;
+    }
+
+    for (i = 0; i < PA_ELEMENTSOF(directories); i++) {
+        char *path = pa_sprintf_malloc("%s" PA_PATH_SEP "%s", directories[i], name);
+        int saved_errno;
+
+        f = pa_fopen_cloexec(path, "r");
+        if (f) {
+            if (result)
+                *result = path;
+            else
+                pa_xfree(path);
+            return f;
+        }
+
+        saved_errno = errno;
+        if (saved_errno != ENOENT)
+            pa_log_warn("Failed to open configuration file '%s': %s", path, pa_cstrerror(saved_errno));
+        pa_xfree(path);
+        errno = saved_errno;
+
+        if (errno != ENOENT)
+            return NULL;
+    }
+
+    errno = ENOENT;
+    return NULL;
+#endif
+}
+
+char *pa_find_layered_config_file(const char *name, const char *local, const char *env) {
+#ifdef OS_IS_WIN32
+    char *global, *result;
+
+    global = pa_sprintf_malloc(PA_DEFAULT_CONFIG_DIR PA_PATH_SEP "%s", name);
+    result = pa_find_config_file(global, local, env);
+    pa_xfree(global);
+    return result;
+#else
+    const char *directories[] = {
+        PA_DEFAULT_CONFIG_DIR,
+        PA_RUNTIME_CONFIG_DIR,
+        PA_VENDOR_CONFIG_DIR,
+    };
+    size_t i;
+
+    pa_assert(name);
+
+    if (env && getenv(env))
+        return pa_find_config_file(NULL, NULL, env);
+
+    if (local) {
+        char *path = NULL;
+        FILE *f = pa_open_config_file(NULL, local, NULL, &path);
+
+        if (f) {
+            fclose(f);
+            return path;
+        }
+
+        if (errno != ENOENT)
+            return NULL;
+    }
+
+    for (i = 0; i < PA_ELEMENTSOF(directories); i++) {
+        char *path = pa_sprintf_malloc("%s" PA_PATH_SEP "%s", directories[i], name);
+        int saved_errno;
+
+        if (access(path, R_OK) == 0)
+            return path;
+
+        saved_errno = errno;
+        if (saved_errno != ENOENT)
+            pa_log_warn("Failed to access configuration file '%s': %s", path, pa_cstrerror(saved_errno));
+        pa_xfree(path);
+        errno = saved_errno;
+
+        if (errno != ENOENT)
+            return NULL;
+    }
+
+    errno = ENOENT;
+    return NULL;
+#endif
+}
