+static int prepare_classid_file(char **path)
+{
+	char *source_path = NULL;
+	FILE *source = NULL;
+	FILE *destination = NULL;
+	char buffer[4096];
+	size_t length;
+	int err = 0;
+
+	if (build_admin_path(path, "classid") < 0)
+		return -NLE_NOMEM;
+
+	if (getenv("NLSYSCONFDIR") || access(*path, F_OK) == 0 || errno != ENOENT)
+		return 0;
+
+	if (mkdir(_NL_SYSCONFDIR_LIBNL, 0755) < 0 && errno != EEXIST) {
+		err = -nl_syserr2nlerr(errno);
+		goto out;
+	}
+
+	if (build_sysconf_path(&source_path, "classid") < 0) {
+		err = -NLE_NOMEM;
+		goto out;
+	}
+	if (!strcmp(source_path, *path))
+		goto out;
+
+	source = fopen(source_path, "re");
+	if (!source)
+		goto out;
+
+	destination = fopen(*path, "wxe");
+	if (!destination) {
+		if (errno != EEXIST)
+			err = -nl_syserr2nlerr(errno);
+		goto out;
+	}
+
+	while ((length = fread(buffer, 1, sizeof(buffer), source)) > 0) {
+		if (fwrite(buffer, 1, length, destination) != length) {
+			err = -nl_syserr2nlerr(errno);
+			break;
+		}
+	}
+	if (ferror(source))
+		err = -nl_syserr2nlerr(errno);
+	if (fclose(destination) != 0 && err == 0)
+		err = -nl_syserr2nlerr(errno);
+	destination = NULL;
+	if (err < 0)
+		unlink(*path);
+
+out:
+	if (destination)
+		fclose(destination);
+	if (source)
+		fclose(source);
+	free(source_path);
+	return err;
+}
+
 int rtnl_classid_generate(const char *name, uint32_t *result, uint32_t parent)
 {
 	static uint32_t base = 0x4000 << 16;
@@ -399,8 +464,8 @@ int rtnl_classid_generate(const char *name, uint32_t *result, uint32_t parent)
 
