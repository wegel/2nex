diff --git a/lib/route/nl-route.h b/lib/route/nl-route.h
index 53d8b9f..0b319ae 100644
--- a/lib/route/nl-route.h
+++ b/lib/route/nl-route.h
@@ -152,14 +152,35 @@ static inline void rtnl_rcopy_ratespec(struct tc_ratespec *dst,
 
 static inline int build_sysconf_path(char **strp, const char *filename)
 {
-	char *sysconfdir;
+	const char *override;
+	const char *directories[] = {
+		_NL_SYSCONFDIR_LIBNL,
+		_NL_RUNTIMEDIR_LIBNL,
+		_NL_VENDORDIR_LIBNL,
+	};
+	size_t i;
 
-	sysconfdir = getenv("NLSYSCONFDIR");
+	override = getenv("NLSYSCONFDIR");
+	if (override)
+		return asprintf(strp, "%s/%s", override, filename);
 
-	if (!sysconfdir)
-		sysconfdir = _NL_SYSCONFDIR_LIBNL;
+	for (i = 0; i < ARRAY_SIZE(directories) - 1; i++) {
+		if (asprintf(strp, "%s/%s", directories[i], filename) < 0)
+			return -1;
+		if (access(*strp, F_OK) == 0 || errno != ENOENT)
+			return 0;
+		free(*strp);
+	}
 
-	return asprintf(strp, "%s/%s", sysconfdir, filename);
+	return asprintf(strp, "%s/%s", _NL_VENDORDIR_LIBNL, filename);
+}
+
+static inline int build_admin_path(char **strp, const char *filename)
+{
+	const char *override = getenv("NLSYSCONFDIR");
+
+	return asprintf(strp, "%s/%s",
+			override ? override : _NL_SYSCONFDIR_LIBNL, filename);
 }
 
