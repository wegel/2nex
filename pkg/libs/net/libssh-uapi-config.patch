From: Package maintainers <packages@localhost>
Subject: follow UAPI configuration file precedence
Source: https://gitlab.com/libssh/libssh-mirror/-/archive/libssh-0.11.4/libssh-mirror-libssh-0.11.4.tar.gz
Upstream: Not submitted; this is a generic UAPI configuration proposal.

Give the client configuration (ssh_config), the server configuration
(libssh_server_config), and the moduli file a /run and vendor tier in
addition to their existing /etc/ssh path, using the same
$(prefix)/lib/ssh, /run/ssh, and $(datadir)/ssh directories that
pkg/cli/net/openssh-uapi-config.patch already gives the same file
names, so the two packages agree about where a deployment and a boot
put SSH policy.

ssh_config_parse_line() skips a keyword already set earlier in the
session (session->opts.options_seen[], see src/config.c), so the
first file that sets a keyword wins for the life of the session,
matching OpenSSH's documented rule. ssh_options_parse_config() now
reads the administrator (/etc), then runtime (/run), then vendor
tier in that order so an administrator value keeps winning.

ssh_bind_config_parse_file() keeps its "seen" table only for the
duration of one call (see the comment on that table in
bind_config.c), so a later call's value overrides rather than is
blocked by an earlier one. ssh_bind_options_parse_config() now reads
the vendor tier first, then runtime, then administrator (/etc) last,
reaching the same administrator-over-runtime-over-vendor result by
the opposite means.

The moduli file is a single file rather than a keyword list, so
ssh_retrieve_dhgroup() now selects the first existing file among the
same three tiers instead of merging them.

A missing vendor or /run path is silent in all three readers:
ssh_strict_fopen() already returns NULL for a missing file without
logging above SSH_LOG_RARE, so a client or server that finds no
system configuration today behaves identically after this change.

Host key defaults (src/bind.c) and known-hosts handling are
untouched: both are per-machine or per-user secrets, not shippable
policy.

diff -urN a/DefineOptions.cmake b/DefineOptions.cmake
--- a/DefineOptions.cmake	2026-02-06 14:13:56.000000000 -0500
+++ b/DefineOptions.cmake	2026-08-19 01:23:13.106459335 -0400
@@ -87,6 +87,46 @@
     set(GLOBAL_CLIENT_CONFIG "${GLOBAL_CONF_DIR}/ssh_config")
 endif (NOT GLOBAL_CLIENT_CONFIG)
 
+# UAPI vendor and runtime configuration tiers. GLOBAL_CONF_DIR above stays the
+# administrator (/etc) tier; these add the /run and vendor tiers that
+# pkg/cli/net/openssh-uapi-config.patch already gives the same file names, so
+# the two packages agree about where a deployment and a boot put SSH policy.
+if (NOT LIBSSH_VENDOR_DIR)
+    set(LIBSSH_VENDOR_DIR "${CMAKE_INSTALL_PREFIX}/lib/ssh")
+endif (NOT LIBSSH_VENDOR_DIR)
+
+if (NOT LIBSSH_VENDOR_SHARE_DIR)
+    set(LIBSSH_VENDOR_SHARE_DIR "${CMAKE_INSTALL_PREFIX}/share/ssh")
+endif (NOT LIBSSH_VENDOR_SHARE_DIR)
+
+if (NOT LIBSSH_RUNTIME_DIR)
+    set(LIBSSH_RUNTIME_DIR "/run/ssh")
+endif (NOT LIBSSH_RUNTIME_DIR)
+
+if (NOT GLOBAL_BIND_CONFIG_RUNTIME)
+    set(GLOBAL_BIND_CONFIG_RUNTIME "${LIBSSH_RUNTIME_DIR}/libssh_server_config")
+endif (NOT GLOBAL_BIND_CONFIG_RUNTIME)
+
+if (NOT GLOBAL_BIND_CONFIG_VENDOR)
+    set(GLOBAL_BIND_CONFIG_VENDOR "${LIBSSH_VENDOR_DIR}/libssh_server_config")
+endif (NOT GLOBAL_BIND_CONFIG_VENDOR)
+
+if (NOT GLOBAL_CLIENT_CONFIG_RUNTIME)
+    set(GLOBAL_CLIENT_CONFIG_RUNTIME "${LIBSSH_RUNTIME_DIR}/ssh_config")
+endif (NOT GLOBAL_CLIENT_CONFIG_RUNTIME)
+
+if (NOT GLOBAL_CLIENT_CONFIG_VENDOR)
+    set(GLOBAL_CLIENT_CONFIG_VENDOR "${LIBSSH_VENDOR_DIR}/ssh_config")
+endif (NOT GLOBAL_CLIENT_CONFIG_VENDOR)
+
+if (NOT MODULI_FILE_RUNTIME)
+    set(MODULI_FILE_RUNTIME "${LIBSSH_RUNTIME_DIR}/moduli")
+endif (NOT MODULI_FILE_RUNTIME)
+
+if (NOT MODULI_FILE_VENDOR)
+    set(MODULI_FILE_VENDOR "${LIBSSH_VENDOR_SHARE_DIR}/moduli")
+endif (NOT MODULI_FILE_VENDOR)
+
 if (FUZZ_TESTING)
     set(WITH_INSECURE_NONE ON)
 endif (FUZZ_TESTING)
