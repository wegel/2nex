@@ -18,9 +18,36 @@
 
 #include <rpc/netdb.h>
 #include <nss.h>
+#include <array_length.h>
+#include <errno.h>
+#include <sys/stat.h>
+
+/* Return the first existing administrative, runtime, or vendor RPC file.
+   Errors other than a missing path preserve the higher-priority choice.  */
+static const char *
+rpc_database_path (void)
+{
+  static const char *const paths[] =
+    {
+      "/etc/rpc",
+      "/run/rpc",
+      "/usr/lib/rpc",
+    };
+
+  for (size_t i = 0; i < array_length (paths); ++i)
+    {
+      struct __stat64_t64 st;
+      if (__stat64_time64 (paths[i], &st) == 0
+          || (errno != ENOENT && errno != ENOTDIR))
+        return paths[i];
+    }
+
+  return paths[array_length (paths) - 1];
+}
 
 #define ENTNAME		rpcent
 #define DATABASE	"rpc"
+#define DATAFILE	rpc_database_path ()
 
 struct rpcent_data {};
 
