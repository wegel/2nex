From: Package maintainers <packages@localhost>
Subject: [PATCH] follow UAPI configuration file precedence
Source: https://ftp.gnu.org/gnu/glibc/glibc-2.39.tar.xz
Upstream: Not submitted; this is a generic UAPI configuration proposal.

Select nsswitch.conf and the RPC database from administrative, runtime,
and vendor paths. Track the selected nsswitch.conf tier as part of the
reload cache so long-lived processes notice files appearing, changing,
and disappearing. Keep nscd tracing consistent with the same paths.
diff --git a/nss/nss_database.c b/nss/nss_database.c
index efe77aeaf..3359991aa 100644
--- a/nss/nss_database.c
+++ b/nss/nss_database.c
@@ -40,6 +40,72 @@ struct nss_database_state
   dev_t root_dev;
 };
 
+enum nsswitch_conf_path
+{
+  nsswitch_conf_none,
+  nsswitch_conf_etc,
+  nsswitch_conf_run,
+  nsswitch_conf_vendor,
+};
+
+struct nsswitch_conf_selection
+{
+  const char *path;
+  enum nsswitch_conf_path id;
+  struct file_change_detection file;
+};
+
+/* Select the first path which exists.  Errors other than a missing path
+   select that path as well, so an inaccessible higher-priority file does
+   not expose a lower-priority configuration.  */
+static bool
+nsswitch_conf_select (struct nsswitch_conf_selection *result)
+{
+  static const struct
+  {
+    const char *path;
+    enum nsswitch_conf_path id;
+  } paths[] =
+    {
+      { _PATH_NSSWITCH_CONF, nsswitch_conf_etc },
+      { _PATH_NSSWITCH_CONF_RUN, nsswitch_conf_run },
+      { _PATH_NSSWITCH_CONF_VENDOR, nsswitch_conf_vendor },
+    };
+
+  for (size_t i = 0; i < array_length (paths); ++i)
+    {
+      struct __stat64_t64 st;
+      if (__stat64_time64 (paths[i].path, &st) == 0)
+        {
+          result->path = paths[i].path;
+          result->id = paths[i].id;
+          __file_change_detection_for_stat (&result->file, &st);
+          return true;
+        }
+
+      if (errno != ENOENT && errno != ENOTDIR)
+        {
+          result->path = paths[i].path;
+          result->id = paths[i].id;
+          return __file_change_detection_for_path (&result->file,
+                                                   result->path);
+        }
+    }
+
+  result->path = NULL;
+  result->id = nsswitch_conf_none;
+  result->file.size = 0;
+  return true;
+}
+
+static bool
+nsswitch_conf_is_unchanged (const struct nsswitch_conf_selection *left,
+                            const struct nss_database_data *right)
+{
+  return left->id == right->nsswitch_conf_path
+    && __file_is_unchanged (&left->file, &right->nsswitch_conf);
+}
+
 
 /* Global NSS database state.  Underlying type is "struct
    nss_database_state *" but the allocate_once API requires
@@ -55,6 +121,7 @@ global_state_allocate (void *closure)
   if (result != NULL)
     {
       result->data.nsswitch_conf.size = -1; /* Force reload.  */
+      result->data.nsswitch_conf_path = nsswitch_conf_none;
       memset (result->data.services, 0, sizeof (result->data.services));
       result->data.initialized = true;
       result->data.reload_disabled = false;
@@ -301,26 +368,31 @@ nss_database_reload_1 (struct nss_database_data *data, FILE *fp)
 
 static bool
 nss_database_reload (struct nss_database_data *staging,
-                     struct file_change_detection *initial)
+                     const struct nsswitch_conf_selection *initial)
 {
-  FILE *fp = fopen (_PATH_NSSWITCH_CONF, "rce");
+  FILE *fp = NULL;
+  if (initial->path != NULL)
+    fp = fopen (initial->path, "rce");
   if (fp == NULL)
-    switch (errno)
-      {
-      case EACCES:
-      case EISDIR:
-      case ELOOP:
-      case ENOENT:
-      case ENOTDIR:
-      case EPERM:
-        /* Ignore these errors.  They are persistent errors caused
-           by file system contents.  */
-        break;
-      default:
-        /* Other errors refer to resource allocation problems and
-           need to be handled by the application.  */
-        return false;
-      }
+    {
+      if (initial->path != NULL)
+        switch (errno)
+          {
+          case EACCES:
+          case EISDIR:
+          case ELOOP:
+          case ENOENT:
+          case ENOTDIR:
+          case EPERM:
+            /* Ignore these errors.  They are persistent errors caused
+               by file system contents.  */
+            break;
+          default:
+            /* Other errors refer to resource allocation problems and
+               need to be handled by the application.  */
+            return false;
+          }
+    }
   else
     /* No other threads have access to fp.  */
     __fsetlocking (fp, FSETLOCKING_BYCALLER);
@@ -373,7 +445,10 @@ nss_database_reload (struct nss_database_data *staging,
     }
 
   if (ok)
-    ok = __file_change_detection_for_fp (&staging->nsswitch_conf, fp);
+    {
+      staging->nsswitch_conf_path = initial->id;
+      ok = __file_change_detection_for_fp (&staging->nsswitch_conf, fp);
+    }
 
   if (fp != NULL)
     {
@@ -382,9 +457,18 @@ nss_database_reload (struct nss_database_data *staging,
       __set_errno (saved_errno);
     }
 
-  if (ok && !__file_is_unchanged (&staging->nsswitch_conf, initial))
-    /* Reload is required because the file changed while reading.  */
-    staging->nsswitch_conf.size = -1;
+  if (ok)
+    {
+      struct nsswitch_conf_selection current;
+      if (!nsswitch_conf_select (&current))
+        ok = false;
+      else if (!__file_is_unchanged (&staging->nsswitch_conf,
+                                     &initial->file)
+               || !nsswitch_conf_is_unchanged (&current, staging))
+        /* Reload is required because the file or selected path changed
+           while reading.  */
+        staging->nsswitch_conf.size = -1;
+    }
 
   return ok;
 }
@@ -406,12 +490,12 @@ nss_database_check_reload_and_get (struct nss_database_state *local,
       return true;
     }
 
-  struct file_change_detection initial;
-  if (!__file_change_detection_for_path (&initial, _PATH_NSSWITCH_CONF))
+  struct nsswitch_conf_selection initial;
+  if (!nsswitch_conf_select (&initial))
     return false;
 
   __libc_lock_lock (local->lock);
-  if (__file_is_unchanged (&initial, &local->data.nsswitch_conf))
+  if (nsswitch_conf_is_unchanged (&initial, &local->data))
     {
       /* Configuration is up-to-date.  Read it and return it to the
          caller.  */
