diff --git a/tmp/src-inspect.ep011/glibc-patch/nss/tst-uapi-config.c b/nss/tst-uapi-config.c
new file mode 100644
index 000000000..52bcf7ffb
--- /dev/null
+++ b/nss/tst-uapi-config.c
@@ -0,0 +1,184 @@
+/* Test UAPI system configuration precedence for NSS and RPC.  */
+
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <gnu/libc-version.h>
+#include <pwd.h>
+#include <rpc/netdb.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static void
+fail (const char *message)
+{
+  fprintf (stderr, "FAIL: %s: %s\n", message, strerror (errno));
+  exit (1);
+}
+
+static void
+make_directory (const char *path)
+{
+  if (mkdir (path, 0755) != 0)
+    fail (path);
+}
+
+static void
+write_all (int fd, const char *contents)
+{
+  size_t length = strlen (contents);
+  while (length > 0)
+    {
+      ssize_t written = write (fd, contents, length);
+      if (written < 0)
+        fail ("write");
+      contents += written;
+      length -= written;
+    }
+}
+
+static void
+replace_file (const char *path, const char *contents)
+{
+  char temporary[256];
+  int length = snprintf (temporary, sizeof (temporary), "%s.new", path);
+  if (length < 0 || (size_t) length >= sizeof (temporary))
+    {
+      errno = ENAMETOOLONG;
+      fail (path);
+    }
+
+  int fd = open (temporary, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+  if (fd < 0)
+    fail (temporary);
+  write_all (fd, contents);
+  if (close (fd) != 0)
+    fail (temporary);
+  if (rename (temporary, path) != 0)
+    fail (path);
+}
+
+static void
+remove_file (const char *path)
+{
+  if (unlink (path) != 0)
+    fail (path);
+}
+
+static void
+expect_passwd (bool found, const char *step)
+{
+  struct passwd value;
+  struct passwd *result = NULL;
+  char buffer[1024];
+  int status = getpwnam_r ("alice", &value, buffer, sizeof (buffer), &result);
+  bool status_ok = status == 0 || (!found && status == ENOENT);
+  if (!status_ok || (result != NULL) != found
+      || (found && result->pw_uid != 1000))
+    {
+      errno = status;
+      fail (step);
+    }
+}
+
+static void
+expect_rpc (int number, const char *step)
+{
+  struct rpcent value;
+  struct rpcent *result = NULL;
+  char buffer[1024];
+  int status = getrpcbyname_r ("uapi-rpc", &value, buffer, sizeof (buffer),
+                               &result);
+  bool found = number >= 0;
+  bool status_ok = status == 0 || (!found && status == ENOENT);
+  if (!status_ok || (result != NULL) != found
+      || (found && result->r_number != number))
+    {
+      errno = status;
+      fail (step);
+    }
+}
+
+int
+main (void)
+{
+  if (strcmp (gnu_get_libc_version (), "2.39") != 0)
+    {
+      errno = 0;
+      fail ("test did not load glibc 2.39");
+    }
+
+  char root[] = "/tmp/glibc-uapi-config-XXXXXX";
+  if (mkdtemp (root) == NULL)
+    fail ("mkdtemp");
+
+  char path[sizeof (root) + 16];
+#define MAKE_DIRECTORY(suffix) \
+  do \
+    { \
+      snprintf (path, sizeof (path), "%s%s", root, suffix); \
+      make_directory (path); \
+    } \
+  while (0)
+  MAKE_DIRECTORY ("/etc");
+  MAKE_DIRECTORY ("/run");
+  MAKE_DIRECTORY ("/usr");
+  MAKE_DIRECTORY ("/usr/lib");
+#undef MAKE_DIRECTORY
+
+  if (chroot (root) != 0 || chdir ("/") != 0)
+    fail ("chroot");
+
+  replace_file ("/etc/passwd",
+                "root:x:0:0:root:/root:/bin/sh\n"
+                "alice:x:1000:1000:Alice:/home/alice:/bin/sh\n");
+  replace_file ("/etc/group", "root:x:0:\nalice:x:1000:\n");
+  replace_file ("/etc/hosts", "127.0.0.1 localhost\n");
+
+  expect_passwd (true, "compiled NSS defaults without a configuration");
+  replace_file ("/usr/lib/nsswitch.conf", "passwd: dns\n");
+  expect_passwd (false, "vendor NSS configuration");
+  replace_file ("/run/nsswitch.conf", "");
+  expect_passwd (true, "empty runtime NSS mask");
+  replace_file ("/run/nsswitch.conf", "passwd: dns\n");
+  expect_passwd (false, "changed runtime NSS configuration");
+  replace_file ("/etc/nsswitch.conf", "passwd: files\n");
+  expect_passwd (true, "administrative NSS configuration");
+  replace_file ("/etc/nsswitch.conf", "passwd: dns\n");
+  expect_passwd (false, "changed administrative NSS configuration");
+  replace_file ("/run/nsswitch.conf", "passwd: files\n");
+  expect_passwd (false, "masked runtime NSS change");
+  remove_file ("/etc/nsswitch.conf");
+  expect_passwd (true, "administrative NSS configuration removal");
+  remove_file ("/run/nsswitch.conf");
+  expect_passwd (false, "runtime NSS configuration removal");
+  replace_file ("/usr/lib/nsswitch.conf", "passwd: files\n");
+  expect_passwd (true, "changed vendor NSS configuration");
+  replace_file ("/usr/lib/nsswitch.conf", "passwd: dns\n");
+  expect_passwd (false, "vendor NSS configuration before removal");
+  remove_file ("/usr/lib/nsswitch.conf");
+  expect_passwd (true, "compiled NSS defaults after removal");
+
+  expect_rpc (-1, "missing RPC configuration");
+  replace_file ("/usr/lib/rpc", "uapi-rpc 400001 uapi-vendor\n");
+  expect_rpc (400001, "vendor RPC configuration");
+  replace_file ("/run/rpc", "uapi-rpc 400002 uapi-runtime\n");
+  expect_rpc (400002, "runtime RPC configuration");
+  replace_file ("/etc/rpc", "uapi-rpc 400003 uapi-admin\n");
+  expect_rpc (400003, "administrative RPC configuration");
+  replace_file ("/etc/rpc", "");
+  expect_rpc (-1, "empty administrative RPC mask");
+  remove_file ("/etc/rpc");
+  expect_rpc (400002, "administrative RPC configuration removal");
+  remove_file ("/run/rpc");
+  expect_rpc (400001, "runtime RPC configuration removal");
+  remove_file ("/usr/lib/rpc");
+  expect_rpc (-1, "vendor RPC configuration removal");
+
+  puts ("UAPI NSS and RPC configuration tests passed");
+  return 0;
+}
