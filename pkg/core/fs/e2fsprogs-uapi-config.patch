From: Nex package maintainers
Subject: [PATCH] config: select mke2fs and e2scrub policy from UAPI paths
Source: Nex
Upstream: not submitted; needs upstream agreement on Linux UAPI paths

Both tools read one main configuration file. Keep the administrator file in
/etc, add a temporary override in /run, and use /usr/lib for the package
default. Select the first existing file so an empty higher-priority file masks
lower policy. Keep MKE2FS_CONFIG as the explicit mke2fs override.

diff --git a/misc/mke2fs.c b/misc/mke2fs.c
--- a/misc/mke2fs.c
+++ b/misc/mke2fs.c
@@ -1218,7 +1218,26 @@
 	exit(1);
 }
 
-static const char *config_fn[] = { ROOT_SYSCONFDIR "/mke2fs.conf", 0 };
+#define VENDOR_MKE2FS_CONFIG "/usr/lib/mke2fs.conf"
+
+static const char *config_fn[] = { 0, 0 };
+static const char *config_paths[] = {
+	ROOT_SYSCONFDIR "/mke2fs.conf",
+	"/run/mke2fs.conf",
+	VENDOR_MKE2FS_CONFIG,
+	0
+};
+
+static const char *get_default_config_file(void)
+{
+	const char **path;
+
+	for (path = config_paths; *path; path++)
+		if (access(*path, F_OK) == 0)
+			return *path;
+
+	return VENDOR_MKE2FS_CONFIG;
+}
 
 static void edit_feature(const char *str, __u32 *compat_array)
 {
@@ -1642,6 +1661,8 @@
 
 	if ((tmp = getenv("MKE2FS_CONFIG")) != NULL)
 		config_fn[0] = tmp;
+	else
+		config_fn[0] = get_default_config_file();
 	profile_set_syntax_err_cb(syntax_err_report);
 	retval = profile_init(config_fn, &profile);
 	if (retval == ENOENT) {
diff --git a/scrub/e2scrub.in b/scrub/e2scrub.in
--- a/scrub/e2scrub.in
+++ b/scrub/e2scrub.in
@@ -34,9 +34,16 @@
 fstrim=0
 reap=0
 e2fsck_opts=""
-conffile="@root_sysconfdir@/e2scrub.conf"
-
-test -f "${conffile}" && . "${conffile}"
+for conffile in \
+    "@root_sysconfdir@/e2scrub.conf" \
+    "/run/e2scrub.conf" \
+    "/usr/lib/e2scrub.conf"; do
+    if test -e "${conffile}"; then
+        . "${conffile}"
+        break
+    fi
+done
+unset conffile
 
 print_help() {
 	echo "Usage: $0 [OPTIONS] mountpoint | device"
