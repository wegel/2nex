@@ -90,7 +90,11 @@
         c_assert(!r);

         c_list_for_each_entry(i_node, &root->node_list, root_link) {
-                fprintf(stderr, "<%s>\n", test_type2str[i_node->type]);
+                if (i_node->type == CONFIG_NODE_INCLUDE)
