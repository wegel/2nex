build:
  script: |
    set -eux
    tar --no-same-owner -xf ${SOURCE_kernel} -C "${WORK_DIR}"
    cd "${WORK_DIR}/linux-6.12.58"

    # set deterministic build environment
    export LD_LIBRARY_PATH="/usr/lib:${LD_LIBRARY_PATH:-}"
    export KBUILD_BUILD_USER="2nex-builder"
    export KBUILD_BUILD_HOST="2nex-builder"
    export KBUILD_BUILD_TIMESTAMP="2024-01-01T00:00:00+00:00"

    # create initramfs using cpio list format (allows device nodes without mknod)
    INITRAMFS_DIR="${WORK_DIR}/initramfs"
    INITRAMFS_LIST="${WORK_DIR}/initramfs.list"
    mkdir -p "${INITRAMFS_DIR}"/{bin,sbin,etc,proc,sys,dev,mnt/root,run,tmp,lib64,usr}

    # create lib symlinks so dynamic linker finds libraries
    ln -s lib64 "${INITRAMFS_DIR}/lib"
    ln -s ../lib64 "${INITRAMFS_DIR}/usr/lib"

    # function to copy a binary and all its library dependencies
    copy_with_libs() {
        local bin="$1"
        local dest="$2"
        echo "initramfs: copying $bin -> $dest"
        cp "$bin" "$dest"
        # use ldd + awk to find all library dependencies (portable, no grep -P)
        for lib in $(ldd "$bin" 2>/dev/null | awk '/=>/ && $3 ~ /^\// {print $3}'); do
            echo "initramfs:   lib: $lib"
            [ -f "$lib" ] && cp -n "$lib" "${INITRAMFS_DIR}/lib64/"
        done
        # copy the dynamic linker
        for ld in $(ldd "$bin" 2>/dev/null | awk '$1 ~ /ld-linux/ {print $1}'); do
            echo "initramfs:   ld: $ld"
            [ -f "$ld" ] && cp -n "$ld" "${INITRAMFS_DIR}/lib64/"
        done
    }

    # copy dynamic busybox with all dependencies
    copy_with_libs /usr/bin/busybox "${INITRAMFS_DIR}/bin/busybox"

    # copy util-linux's blkid with all dependencies
    copy_with_libs /usr/bin/blkid "${INITRAMFS_DIR}/sbin/blkid"

    # create essential busybox symlinks
    for cmd in ash sh cat cp cut dd df echo grep kill ln ls mkdir mknod mount \
               mv ps pwd rm rmdir sed sleep sync tar touch tr umount \
               basename dirname readlink; do
        ln -sf busybox "${INITRAMFS_DIR}/bin/$cmd"
    done
    for cmd in init switch_root pivot_root findfs; do
        ln -sf ../bin/busybox "${INITRAMFS_DIR}/sbin/$cmd"
    done

    # copy init script from source
    cp "/${SOURCE_initramfs_init}" "${INITRAMFS_DIR}/init"
    chmod +x "${INITRAMFS_DIR}/init"

    # minimal etc files
    echo "root:x:0:0:root:/root:/bin/sh" > "${INITRAMFS_DIR}/etc/passwd"
    echo "root:x:0:" > "${INITRAMFS_DIR}/etc/group"

    # deterministic timestamps for initramfs
    find "${INITRAMFS_DIR}" -exec touch -d "2024-01-01T00:00:00+00:00" {} \;

    # create cpio list with device nodes (works in unshare)
    cat > "${INITRAMFS_LIST}" <<'CPIO_EOF'
    nod /dev/console 0622 0 0 c 5 1
    nod /dev/null 0666 0 0 c 1 3
    nod /dev/zero 0666 0 0 c 1 5
    nod /dev/tty 0666 0 0 c 5 0
    CPIO_EOF

    # generate config from defconfig + fragment + initramfs
    make x86_64_defconfig
    cat /${SOURCE_config_fragment} >> .config
    echo "CONFIG_INITRAMFS_SOURCE=\"${INITRAMFS_DIR} ${INITRAMFS_LIST}\"" >> .config
    echo "CONFIG_INITRAMFS_ROOT_UID=0" >> .config
    echo "CONFIG_INITRAMFS_ROOT_GID=0" >> .config
    make olddefconfig

    # build kernel and modules
    make -j$(nproc)

    # install kernel image
    mkdir -p ${OUT_DIR}/boot
    cp -v arch/x86/boot/bzImage ${OUT_DIR}/boot/vmlinuz-6.12.58
    cp -v System.map ${OUT_DIR}/boot/System.map-6.12.58
    cp -v .config ${OUT_DIR}/boot/config-6.12.58

    # install modules (to /usr/lib/modules for usr-merge compatibility)
    make INSTALL_MOD_PATH=${OUT_DIR}/usr modules_install

    # deterministic timestamps
    find "${OUT_DIR}" -exec touch -d "2024-01-01T00:00:00+00:00" {} \;

    # strip kernel modules with --strip-debug to preserve symbols needed by modprobe
    find "${OUT_DIR}" -name "*.ko" -exec strip --strip-debug {} \;
