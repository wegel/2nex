 	int r, opt, do_dump_cfg = 0, keytype, already_daemon, have_agent = 0;
 	int sock_in = -1, sock_out = -1, newsock = -1, rexec_argc = 0;
 	int devnull, config_s[2] = { -1 , -1 }, have_connection_info = 0;
 	int need_chroot = 1;
 	char *fp, *line, *logfile = NULL, **rexec_argv = NULL;
+	char *system_config = NULL, **config_dropins = NULL;
+	size_t nconfig_dropins = 0;
 	struct stat sb;
 	u_int i, j;
 	mode_t new_umask;
@@ -1246,6 +1269,7 @@ main(int ac, char **av)
 			break;
 		case 'f':
 			config_file_name = optarg;
+			config_file_explicit = 1;
 			break;
 		case 'c':
 			servconf_add_hostcert("[command-line]", 0,
@@ -1407,8 +1431,31 @@ main(int ac, char **av)
 	/* Fetch our configuration */
 	if ((cfg = sshbuf_new()) == NULL)
 		fatal("sshbuf_new config failed");
-	if (strcasecmp(config_file_name, "none") != 0)
-		load_server_config(config_file_name, cfg);
+	if (strcasecmp(config_file_name, "none") != 0) {
+		if (config_file_explicit) {
+			load_server_config(config_file_name, cfg);
+		} else {
+			if (system_config_dropins("sshd_config", &config_dropins,
+			    &nconfig_dropins) != 0)
+				fatal("Can't select system configuration drop-ins: %s",
+				    strerror(errno));
+			for (i = 0; i < nconfig_dropins; i++)
+				append_config_include(cfg, config_dropins[i]);
+			system_config_free(config_dropins, nconfig_dropins);
+			config_dropins = NULL;
+			r = system_config_file("sshd_config", &system_config);
+			if (r == -1)
+				fatal("Can't select system config file: %s",
+				    strerror(errno));
+			if (r == 0)
+				fatal("No system sshd_config found in %s, %s, or %s",
+				    SSHDIR, SSH_RUNTIME_DIR, SSH_VENDOR_DIR);
+			append_config_include(cfg, system_config);
+			config_file_name = system_config;
+			if ((r = sshbuf_put_u8(cfg, 0)) != 0)
+				fatal_fr(r, "sshbuf_put_u8");
