diff --git a/openssh-patch/regress/system-config-test.c b/regress/system-config-test.c
new file mode 100644
index 0000000..1f129a1
--- /dev/null
+++ b/regress/system-config-test.c
@@ -0,0 +1,133 @@
+/* Test UAPI system configuration file selection. */
+
+#include "includes.h"
+
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "system-config.h"
+
+static void
+fail(const char *message)
+{
+	fprintf(stderr, "system-config-test: %s: %s\n", message,
+	    strerror(errno));
+	exit(1);
+}
+
+static void
+make_dir(const char *path)
+{
+	if (mkdir(path, 0755) != 0 && errno != EEXIST)
+		fail(path);
+}
+
+static void
+make_file(const char *path)
+{
+	int fd;
+
+	if ((fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644)) == -1)
+		fail(path);
+	if (close(fd) != 0)
+		fail(path);
+}
+
+static void
+expect_file(const char *want)
+{
+	char *path = NULL;
+	int r;
+
+	if ((r = system_config_file("ssh_config", &path)) != 1) {
+		errno = r == 0 ? ENOENT : errno;
+		fail("system_config_file");
+	}
+	if (strcmp(path, want) != 0) {
+		fprintf(stderr, "system-config-test: got %s, want %s\n",
+		    path, want);
+		exit(1);
+	}
+	free(path);
+}
+
+static void
+expect_dropins(void)
+{
+	const char *want[] = {
+	    "/etc/ssh/ssh_config.d/99-empty.conf",
+	    "/usr/lib/ssh/ssh_config.d/90-late.conf",
+	    "/etc/ssh/ssh_config.d/50-mask.conf",
+	    "/usr/lib/ssh/ssh_config.d/10-early.conf"
+	};
+	char **paths = NULL;
+	size_t i, npaths = 0;
+
+	if (system_config_dropins("ssh_config", &paths, &npaths) != 0)
+		fail("system_config_dropins");
+	if (npaths != sizeof(want) / sizeof(want[0])) {
+		fprintf(stderr, "system-config-test: got %zu drop-ins, want %zu\n",
+		    npaths, sizeof(want) / sizeof(want[0]));
+		exit(1);
+	}
+	for (i = 0; i < npaths; i++) {
+		if (strcmp(paths[i], want[i]) == 0)
+			continue;
+		fprintf(stderr,
+		    "system-config-test: drop-in %zu is %s, want %s\n",
+		    i, paths[i], want[i]);
+		exit(1);
+	}
+	system_config_free(paths, npaths);
+}
+
+int
+main(void)
+{
+	char root[] = "/tmp/system-config-test.XXXXXXXX";
+
+	if (mkdtemp(root) == NULL)
+		fail("mkdtemp");
+	if (chroot(root) != 0 || chdir("/") != 0)
+		fail("chroot");
+	make_dir("/etc");
+	make_dir("/etc/ssh");
+	make_dir("/run");
+	make_dir("/run/ssh");
+	make_dir("/usr");
+	make_dir("/usr/lib");
+	make_dir("/usr/lib/ssh");
+	make_dir("/dev");
+	make_file("/dev/null");
+
+	make_file("/usr/lib/ssh/ssh_config");
+	expect_file("/usr/lib/ssh/ssh_config");
+	make_file("/run/ssh/ssh_config");
+	expect_file("/run/ssh/ssh_config");
+	if (symlink("/dev/null", "/etc/ssh/ssh_config") != 0)
+		fail("symlink");
+	expect_file("/etc/ssh/ssh_config");
+
+	make_dir("/usr/lib/ssh/ssh_config.d");
+	make_dir("/run/ssh/ssh_config.d");
+	make_dir("/etc/ssh/ssh_config.d");
+	make_file("/usr/lib/ssh/ssh_config.d/10-early.conf");
+	make_file("/usr/lib/ssh/ssh_config.d/50-mask.conf");
+	make_file("/usr/lib/ssh/ssh_config.d/90-late.conf");
+	make_file("/run/ssh/ssh_config.d/50-mask.conf");
+	if (symlink("/dev/null", "/etc/ssh/ssh_config.d/50-mask.conf") != 0)
+		fail("symlink");
+	make_file("/etc/ssh/ssh_config.d/99-empty.conf");
+	make_file("/etc/ssh/ssh_config.d/ignored.txt");
+	expect_dropins();
+
+	puts("system config selection tests passed");
+	return 0;
+}
