+
+#include "includes.h"
+
+#include <sys/types.h>
+#include <sys/stat.h>
+
+#include <dirent.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "system-config.h"
+
+#ifndef SSH_RUNTIME_DIR
+#define SSH_RUNTIME_DIR "/run/ssh"
+#endif
+#ifndef SSH_VENDOR_DIR
+#define SSH_VENDOR_DIR "/usr/lib/ssh"
+#endif
+
+struct config_entry {
+	char *name;
+	char *path;
+};
+
+static char *
+config_strdup(const char *s)
+{
+	size_t len;
+	char *ret;
+
+	len = strlen(s) + 1;
+	if ((ret = malloc(len)) == NULL)
+		return NULL;
+	memcpy(ret, s, len);
+	return ret;
+}
+
+static char *
+config_path(const char *dir, const char *name, const char *suffix)
+{
+	size_t dirlen, namelen, suffixlen, len;
+	char *ret;
+
+	dirlen = strlen(dir);
+	namelen = strlen(name);
+	suffixlen = suffix == NULL ? 0 : strlen(suffix);
+	if (dirlen > SIZE_MAX - namelen - suffixlen - 2) {
+		errno = ENAMETOOLONG;
+		return NULL;
+	}
+	len = dirlen + 1 + namelen + suffixlen + 1;
+	if ((ret = malloc(len)) == NULL)
+		return NULL;
+	(void)snprintf(ret, len, "%s/%s%s", dir, name,
+	    suffix == NULL ? "" : suffix);
+	return ret;
+}
+
+int
+system_config_file(const char *name, char **pathp)
+{
+	const char *dirs[] = { SSHDIR, SSH_RUNTIME_DIR, SSH_VENDOR_DIR };
+	struct stat st;
+	size_t i;
+	char *path;
+
+	*pathp = NULL;
+	for (i = 0; i < sizeof(dirs) / sizeof(dirs[0]); i++) {
+		if ((path = config_path(dirs[i], name, NULL)) == NULL)
+			return -1;
+		if (lstat(path, &st) == 0) {
+			*pathp = path;
+			return 1;
+		}
+		if (errno != ENOENT && errno != ENOTDIR) {
+			free(path);
+			return -1;
+		}
+		free(path);
+	}
+	return 0;
+}
+
+static int
+has_conf_suffix(const char *name)
+{
+	size_t len;
+
+	len = strlen(name);
+	return len > 5 && strcmp(name + len - 5, ".conf") == 0;
+}
+
+static int
+replace_entry(struct config_entry **entriesp, size_t *nentriesp,
+    const char *name, const char *path)
+{
+	struct config_entry *entries, *new_entries;
+	char *new_name, *new_path;
+	size_t i, nentries;
+
+	entries = *entriesp;
+	nentries = *nentriesp;
+	if ((new_path = config_strdup(path)) == NULL)
+		return -1;
+	for (i = 0; i < nentries; i++) {
+		if (strcmp(entries[i].name, name) != 0)
+			continue;
+		free(entries[i].path);
+		entries[i].path = new_path;
+		return 0;
+	}
+	if ((new_name = config_strdup(name)) == NULL) {
+		free(new_path);
+		return -1;
+	}
+	if (nentries == SIZE_MAX / sizeof(*entries)) {
+		free(new_name);
+		free(new_path);
+		errno = ENOMEM;
+		return -1;
+	}
+	new_entries = realloc(entries, (nentries + 1) * sizeof(*entries));
+	if (new_entries == NULL) {
+		free(new_name);
+		free(new_path);
+		return -1;
+	}
+	new_entries[nentries].name = new_name;
+	new_entries[nentries].path = new_path;
+	*entriesp = new_entries;
+	*nentriesp = nentries + 1;
+	return 0;
+}
+
+static int
+collect_dir(const char *base, const char *name,
+    struct config_entry **entriesp, size_t *nentriesp)
+{
+	struct dirent *de;
+	DIR *dir;
+	char *dirname, *path;
+	int saved_errno;
+
+	if ((dirname = config_path(base, name, ".d")) == NULL)
+		return -1;
+	if ((dir = opendir(dirname)) == NULL) {
+		saved_errno = errno;
+		free(dirname);
+		if (saved_errno == ENOENT || saved_errno == ENOTDIR)
+			return 0;
+		errno = saved_errno;
+		return -1;
+	}
+	errno = 0;
+	while ((de = readdir(dir)) != NULL) {
+		if (!has_conf_suffix(de->d_name))
+			continue;
+		if ((path = config_path(dirname, de->d_name, NULL)) == NULL)
+			goto fail;
+		if (replace_entry(entriesp, nentriesp, de->d_name, path) != 0) {
+			free(path);
+			goto fail;
+		}
+		free(path);
+	}
+	if (errno != 0)
+		goto fail;
+	free(dirname);
+	if (closedir(dir) != 0)
+		return -1;
+	return 0;
+
+ fail:
+	saved_errno = errno;
+	free(dirname);
+	(void)closedir(dir);
+	errno = saved_errno;
+	return -1;
+}
+
+static int
+entry_compare_desc(const void *va, const void *vb)
+{
+	const struct config_entry *a = va;
+	const struct config_entry *b = vb;
+
+	return strcmp(b->name, a->name);
+}
+
+void
+system_config_free(char **paths, size_t npaths)
+{
+	size_t i;
+
+	for (i = 0; i < npaths; i++)
+		free(paths[i]);
+	free(paths);
+}
+
+int
+system_config_dropins(const char *name, char ***pathsp, size_t *npathsp)
+{
+	const char *dirs[] = { SSH_VENDOR_DIR, SSH_RUNTIME_DIR, SSHDIR };
+	struct config_entry *entries = NULL;
+	char **paths = NULL;
+	size_t i, nentries = 0;
+
+	*pathsp = NULL;
+	*npathsp = 0;
+	for (i = 0; i < sizeof(dirs) / sizeof(dirs[0]); i++) {
+		if (collect_dir(dirs[i], name, &entries, &nentries) != 0)
+			goto fail;
+	}
+	qsort(entries, nentries, sizeof(*entries), entry_compare_desc);
+	if (nentries != 0 &&
+	    (paths = calloc(nentries, sizeof(*paths))) == NULL)
+		goto fail;
+	for (i = 0; i < nentries; i++) {
+		paths[i] = entries[i].path;
+		entries[i].path = NULL;
+		free(entries[i].name);
+	}
+	free(entries);
+	*pathsp = paths;
+	*npathsp = nentries;
+	return 0;
+
+ fail:
+	for (i = 0; i < nentries; i++) {
+		free(entries[i].name);
+		free(entries[i].path);
+	}
+	free(entries);
+	free(paths);
+	return -1;
+}
