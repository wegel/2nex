+static void
+append_config_include(struct sshbuf *conf, const char *path)
+{
+	const char *cp;
+	int r;
+
+	if ((r = sshbuf_put(conf, "Include \"", 9)) != 0)
+		fatal_fr(r, "sshbuf_put");
+	for (cp = path; *cp != '\0'; cp++) {
+		if ((*cp == '\\' || *cp == '"') &&
+		    (r = sshbuf_put_u8(conf, '\\')) != 0)
+			fatal_fr(r, "sshbuf_put_u8");
+		if ((r = sshbuf_put_u8(conf, *cp)) != 0)
+			fatal_fr(r, "sshbuf_put_u8");
+	}
+	if ((r = sshbuf_put(conf, "\"\n", 2)) != 0)
+		fatal_fr(r, "sshbuf_put");
+}
+
 /*
  * Main program for the daemon.
  */
