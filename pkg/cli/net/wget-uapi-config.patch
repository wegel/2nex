+static const char *
+wgetrc_system_file_name (file_stats_t *flstats)
+{
+  static const char *paths[] = {
+    "/etc/wgetrc",
+    "/run/wgetrc",
+    "/usr/lib/wgetrc"
+  };
+  size_t i;
+
+  for (i = 0; i < countof (paths); i++)
+    if (file_exists_p (paths[i], flstats))
+      return paths[i];
+
+  return NULL;
+}
