+static int readConfigPathSet(const char * const *directories,
+                             struct logInfo *defConfig)
+{
+    char **names = NULL;
+    unsigned names_count = 0;
+    int result = 0;
+    const char * const *directory;
+
+    for (directory = directories; *directory; directory++) {
+        struct dirent *entry;
+        DIR *dir = opendir(*directory);
+
+        if (dir == NULL) {
+            if (errno != ENOENT) {
+                message(MESS_ERROR, "cannot open directory %s: %s\n",
+                        *directory, strerror(errno));
+                result = 1;
+            }
+            continue;
+        }
+
+        while ((entry = readdir(dir)) != NULL) {
+            unsigned i;
+            char **new_names;
+
+            if (!checkFile(entry->d_name))
+                continue;
+
+            for (i = 0; i < names_count; i++) {
+                if (strcmp(names[i], entry->d_name) == 0)
+                    break;
+            }
+            if (i != names_count)
+                continue;
+
+            new_names = reallocarray(names, names_count + 1, sizeof(*names));
+            if (new_names == NULL) {
+                message_OOM();
+                closedir(dir);
+                free_2d_array(names, names_count);
+                return 1;
+            }
+            names = new_names;
+            names[names_count] = strdup(entry->d_name);
+            if (names[names_count] == NULL) {
+                message_OOM();
+                closedir(dir);
+                free_2d_array(names, names_count);
+                return 1;
+            }
+            names_count++;
+        }
+        closedir(dir);
+    }
+
+    if (names_count > 0)
+        qsort(names, names_count, sizeof(*names), compar);
+
+    for (unsigned i = 0; i < names_count; i++) {
+        char *selected = NULL;
+
+        for (directory = directories; *directory; directory++) {
+            struct stat sb;
+            char *candidate = NULL;
+
+            if (asprintf(&candidate, "%s/%s", *directory, names[i]) < 0) {
+                message_OOM();
+                result = 1;
+                break;
+            }
+            if (lstat(candidate, &sb) == 0 || errno != ENOENT) {
+                selected = candidate;
+                break;
+            }
+            free(candidate);
+        }
+
+        if (selected != NULL) {
+            if (readConfigPath(selected, defConfig))
+                result = 1;
+            free(selected);
+        }
+    }
+
+    free_2d_array(names, names_count);
+    return result;
+}
