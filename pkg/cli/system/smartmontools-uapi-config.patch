From: Nex package maintainers
Subject: [PATCH] smartd: follow UAPI configuration file precedence
Source: Nex
Upstream: not submitted; suitable for upstream review

Let a machine owner override temporary or vendor configuration without copying
the vendor file into /etc. The ordered smartd grammar cannot safely merge
drop-ins, so select one complete file as UAPI.6 permits. Re-evaluate the
default path on reload so a newly created or removed local override takes
effect. An explicit --configfile continues to select exactly that file.

diff --git a/smartd.cpp b/smartd.cpp
index 510e0f6..c74d1a7 100644
--- a/smartd.cpp
+++ b/smartd.cpp
@@ -168,0 +169,2 @@ static const char * configfile;
+// true unless -c selected an explicit file or standard input
+static bool configfile_default;
@@ -173,0 +176,30 @@ static std::string configfile_alt;
+#ifndef _WIN32
+#ifndef SMARTMONTOOLS_SMARTDCONFRUNDIR
+#define SMARTMONTOOLS_SMARTDCONFRUNDIR "/run/smartmontools"
+#endif
+#ifndef SMARTMONTOOLS_SMARTDCONFVENDORDIR
+#define SMARTMONTOOLS_SMARTDCONFVENDORDIR "/usr/lib/smartmontools"
+#endif
+
+static const char * select_default_configfile()
+{
+  static const char * const paths[] = {
+    SMARTMONTOOLS_SYSCONFDIR "/smartd.conf",
+    SMARTMONTOOLS_SMARTDCONFRUNDIR "/smartd.conf",
+    SMARTMONTOOLS_SMARTDCONFVENDORDIR "/smartd.conf"
+  };
+
+  for (const char * path : paths) {
+    if (!access(path, F_OK))
+      return path;
+  }
+  return paths[0];
+}
+
+static void refresh_default_configfile()
+{
+  if (configfile_default)
+    configfile = select_default_configfile();
+}
+#endif
+
@@ -5467,9 +5499,11 @@ static int parse_options(int argc, char **argv)
 {
   // Init default path names
 #ifndef _WIN32
-  configfile = SMARTMONTOOLS_SYSCONFDIR "/smartd.conf";
+  configfile_default = true;
+  configfile = select_default_configfile();
   warning_script = SMARTMONTOOLS_SMARTDSCRIPTDIR "/smartd_warning.sh";
 #else
+  configfile_default = false;
   std::string exedir = get_exe_dir();
   static std::string configfile_str = exedir + "/smartd.conf";
   configfile = configfile_str.c_str();
@@ -5641,6 +5675,7 @@ static int parse_options(int argc, char **argv)
       break;
     case 'c':
       // alternate configuration file
+      configfile_default = false;
       if (strcmp(optarg,"-"))
         configfile = (configfile_alt = optarg).c_str();
       else // read from stdin
@@ -6140,6 +6175,9 @@ static int main_worker(int argc, char **argv)
   do {
     // Should we (re)read the config file?
     if (firstpass || caughtsigHUP){
+#ifndef _WIN32
+      refresh_default_configfile();
+#endif
       if (!firstpass) {
         // Write state files
         if (!state_path_prefix.empty())
