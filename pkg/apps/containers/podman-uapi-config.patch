+		return []string{filepath.Join(sys.RootForImplicitAbsolutePaths, systemRegistriesDirPath)}
+	}
+	if systemRegistriesDirPath != builtinRegistriesDirPath {
+		// Overridden at build time; honour that single directory exactly.
+		return []string{systemRegistriesDirPath}
+	}
+
+	return []string{vendorRegistriesDirPath, runtimeRegistriesDirPath, systemRegistriesDirPath}
