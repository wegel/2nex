+package sysregistriesv2
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/containers/image/v5/types"
+)
+
+func writeRegistryConfig(t *testing.T, root, path, registry string) {
+	t.Helper()
+	fullPath := filepath.Join(root, path)
+	if err := os.MkdirAll(filepath.Dir(fullPath), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	content := []byte("unqualified-search-registries = [\"" + registry + "\"]\n")
+	if err := os.WriteFile(fullPath, content, 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func checkRegistryTier(t *testing.T, ctx *types.SystemContext, want string) {
+	t.Helper()
+	InvalidateCache()
+	got, err := UnqualifiedSearchRegistries(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, []string{want}) {
+		t.Fatalf("registries are %v, want [%s]", got, want)
+	}
+}
+
+func TestNexMainConfigOrder(t *testing.T) {
+	root := t.TempDir()
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	ctx := &types.SystemContext{RootForImplicitAbsolutePaths: root}
+
+	writeRegistryConfig(t, root, vendorRegistriesConfPath, "vendor.example")
+	checkRegistryTier(t, ctx, "vendor.example")
+	writeRegistryConfig(t, root, runtimeRegistriesConfPath, "runtime.example")
+	checkRegistryTier(t, ctx, "runtime.example")
+	writeRegistryConfig(t, root, systemRegistriesConfPath, "admin.example")
+	checkRegistryTier(t, ctx, "admin.example")
+
+	if err := os.WriteFile(filepath.Join(root, systemRegistriesConfPath), nil, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	InvalidateCache()
+	got, err := UnqualifiedSearchRegistries(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 0 {
+		t.Fatalf("empty administrator file did not mask lower files: %v", got)
+	}
+}
+
+func TestNexDropInOrder(t *testing.T) {
+	root := t.TempDir()
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	ctx := &types.SystemContext{RootForImplicitAbsolutePaths: root}
+
+	writeRegistryConfig(t, root, filepath.Join(vendorRegistriesConfDirPath, "10-tier.conf"), "vendor.example")
+	writeRegistryConfig(t, root, filepath.Join(runtimeRegistriesConfDirPath, "10-tier.conf"), "runtime.example")
+	writeRegistryConfig(t, root, filepath.Join(systemRegistriesConfDirPath, "10-tier.conf"), "admin.example")
+	checkRegistryTier(t, ctx, "admin.example")
+}
