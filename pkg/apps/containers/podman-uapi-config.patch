+package config
+
+import (
+	"os"
+	"testing"
+)
+
+func TestNexSystemConfigOrder(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	t.Setenv("XDG_CONFIG_HOME", "")
+	if err := os.Unsetenv(containersConfEnv); err != nil {
+		t.Fatal(err)
+	}
+
+	configs, err := systemConfigs()
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []string{
+		"/usr/share/containers/containers.conf",
+		"/run/containers/containers.conf",
+		"/etc/containers/containers.conf",
+	}
+	if len(configs) < len(want) {
+		t.Fatalf("configuration list is too short: %v", configs)
+	}
+	for i := range want {
+		if configs[i] != want[i] {
+			t.Fatalf("configuration %d is %q, want %q", i, configs[i], want[i])
+		}
+	}
+}
