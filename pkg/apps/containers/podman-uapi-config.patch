+package types
+
+import (
+	"testing"
+)
+
+// TestNexStorageRuntimeTierDefined checks that the transient machine policy
+// sits between the administrator override and the package default, which is
+// what lets a boot-time tool supply storage settings.
+func TestNexStorageRuntimeTierDefined(t *testing.T) {
+	if RuntimeConfigFile == "" {
+		t.Fatal("RuntimeConfigFile is empty")
+	}
+	if RuntimeConfigFile == SystemConfigFile {
+		t.Fatal("the transient tier duplicates the package default")
+	}
+	if RuntimeConfigFile == defaultOverrideConfigFile {
+		t.Fatal("the transient tier duplicates the administrator override")
+	}
+}
