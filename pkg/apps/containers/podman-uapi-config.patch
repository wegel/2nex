+package signature
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/containers/image/v5/types"
+)
+
+func writePolicy(t *testing.T, root, path, policyType string) {
+	t.Helper()
+	fullPath := filepath.Join(root, path)
+	if err := os.MkdirAll(filepath.Dir(fullPath), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	content := []byte("{\"default\":[{\"type\":\"" + policyType + "\"}]}\n")
+	if err := os.WriteFile(fullPath, content, 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func checkPolicyType(t *testing.T, ctx *types.SystemContext, want string) {
+	t.Helper()
+	policy, err := DefaultPolicy(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(policy.Default) != 1 {
+		t.Fatalf("default policy has %d requirements", len(policy.Default))
+	}
+	switch policy.Default[0].(type) {
+	case *prReject:
+		if want != "reject" {
+			t.Fatalf("selected reject policy, want %s", want)
+		}
+	case *prInsecureAcceptAnything:
+		if want != "insecureAcceptAnything" {
+			t.Fatalf("selected insecure policy, want %s", want)
+		}
+	default:
+		t.Fatalf("unexpected policy type %T", policy.Default[0])
+	}
+}
+
+func TestNexPolicyOrder(t *testing.T) {
+	root := t.TempDir()
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	ctx := &types.SystemContext{RootForImplicitAbsolutePaths: root}
+
+	writePolicy(t, root, "/usr/share/containers/policy.json", "reject")
+	checkPolicyType(t, ctx, "reject")
+	writePolicy(t, root, "/run/containers/policy.json", "insecureAcceptAnything")
+	checkPolicyType(t, ctx, "insecureAcceptAnything")
+	writePolicy(t, root, "/etc/containers/policy.json", "reject")
+	checkPolicyType(t, ctx, "reject")
+
+	if err := os.WriteFile(filepath.Join(root, "/etc/containers/policy.json"), nil, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := DefaultPolicy(ctx); err == nil {
+		t.Fatal("empty administrator policy did not mask lower files")
+	}
+}
