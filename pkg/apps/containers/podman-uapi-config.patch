+package docker
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// TestNexRegistriesDirTiersMergeByBasename checks that a later directory in the
+// list replaces the same file name from an earlier one, that a non-regular file
+// masks the lower name, and that distinct names all survive.
+func TestNexRegistriesDirTiersMergeByBasename(t *testing.T) {
+	root := t.TempDir()
+	vendorDir := filepath.Join(root, "vendor")
+	runtimeDir := filepath.Join(root, "run")
+	adminDir := filepath.Join(root, "etc")
+
+	for _, dir := range []string{vendorDir, runtimeDir, adminDir} {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	write := func(dir, name, body string) {
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(body), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	write(vendorDir, "10-shared.yaml", "docker:\n  example.com:\n    lookaside: file:///vendor\n")
+	write(vendorDir, "20-vendor-only.yaml", "docker:\n  vendor.example:\n    lookaside: file:///vendor-only\n")
+
+	config, err := loadAndMergeConfig(vendorDir, runtimeDir, adminDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := config.Docker["example.com"].Lookaside; got != "file:///vendor" {
+		t.Fatalf("vendor tier: got %q", got)
+	}
+
+	// The transient directory replaces the same file name.
+	write(runtimeDir, "10-shared.yaml", "docker:\n  example.com:\n    lookaside: file:///runtime\n")
+	config, err = loadAndMergeConfig(vendorDir, runtimeDir, adminDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := config.Docker["example.com"].Lookaside; got != "file:///runtime" {
+		t.Fatalf("runtime tier: got %q", got)
+	}
+
+	// The administrator directory replaces both.
+	write(adminDir, "10-shared.yaml", "docker:\n  example.com:\n    lookaside: file:///admin\n")
+	config, err = loadAndMergeConfig(vendorDir, runtimeDir, adminDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := config.Docker["example.com"].Lookaside; got != "file:///admin" {
+		t.Fatalf("admin tier: got %q", got)
+	}
+
+	// A file only the vendor directory supplies still survives the merge.
+	if got := config.Docker["vendor.example"].Lookaside; got != "file:///vendor-only" {
+		t.Fatalf("vendor-only entry lost: got %q", got)
+	}
+
+	// A link to /dev/null masks the same name in every lower directory.
+	if err := os.Remove(filepath.Join(adminDir, "10-shared.yaml")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(os.DevNull, filepath.Join(adminDir, "10-shared.yaml")); err != nil {
+		t.Fatal(err)
+	}
+	config, err = loadAndMergeConfig(vendorDir, runtimeDir, adminDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := config.Docker["example.com"]; ok {
+		t.Fatal("a /dev/null entry did not mask the lower directories")
+	}
+	if got := config.Docker["vendor.example"].Lookaside; got != "file:///vendor-only" {
+		t.Fatalf("masking dropped an unrelated entry: got %q", got)
+	}
+}
+
+// TestNexRegistriesDirPathsOrder checks that the default list is lowest
+// priority first and that an explicit path still selects one directory.
+func TestNexRegistriesDirPathsOrder(t *testing.T) {
+	paths := registriesDirPaths(nil)
+	want := []string{vendorRegistriesDirPath, runtimeRegistriesDirPath, builtinRegistriesDirPath}
+	if len(paths) != len(want) {
+		t.Fatalf("got %v", paths)
+	}
+	for i := range want {
+		if paths[i] != want[i] {
+			t.Fatalf("position %d: got %q, want %q", i, paths[i], want[i])
+		}
+	}
+}
