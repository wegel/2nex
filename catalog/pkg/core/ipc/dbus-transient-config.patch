+/*
+ * Merge one drop-in family across the vendor, runtime, and administrator
+ * trees. A file in a higher tree replaces the same basename in a lower one,
+ * and a symbolic link to /dev/null masks it entirely. The survivors are read
+ * in sorted order so a bus's own "later rule wins" semantics stay predictable
+ * rather than depending on readdir order.
+ */
+static int
+basename_compare (const void *a,
+                  const void *b)
+{
+  return strcmp (*(const char **) a, *(const char **) b);
+}
+
+static dbus_bool_t
+include_dir_family (BusConfigParser   *parser,
+                    const DBusString  *family,
+                    DBusError         *error)
+{
+  /*
+   * The vendor directory keeps upstream's meaning: it is relative to the
+   * configuration file that names the family, so a bus started from a staged
+   * tree still finds its own drop-ins. The transient and administrator trees
+   * are absolute machine locations.
+   */
+  static const char *const absolute_roots[] =
+  {
+    "/run/dbus-1",
+    DBUS_SYSCONFDIR "/dbus-1"
+  };
+  char **names = NULL;
+  char **paths = NULL;
+  int n_names = 0;
+  size_t i;
+  int j;
+  dbus_bool_t retval = FALSE;
+
+  for (i = 0; i < _DBUS_N_ELEMENTS (absolute_roots) + 1; i++)
+    {
+      DBusString dirname;
+      DBusString filename;
+      DBusDirIter *dir;
+      DBusError tmp_error;
+
+      if (!_dbus_string_init (&dirname))
+        {
+          BUS_SET_OOM (error);
+          goto out;
+        }
+
+      if (i == 0)
+        {
+          if (!make_full_path (&parser->basedir, family, &dirname))
+            {
+              _dbus_string_free (&dirname);
+              BUS_SET_OOM (error);
+              goto out;
+            }
+        }
+      else if (!_dbus_string_append (&dirname, absolute_roots[i - 1]) ||
+               !_dbus_string_append (&dirname, "/") ||
+               !_dbus_string_copy (family, 0, &dirname,
+                                   _dbus_string_get_length (&dirname)))
+        {
+          _dbus_string_free (&dirname);
+          BUS_SET_OOM (error);
+          goto out;
+        }
+
+      dbus_error_init (&tmp_error);
+      dir = _dbus_directory_open (&dirname, &tmp_error);
+
+      if (dir == NULL)
+        {
+          dbus_error_free (&tmp_error);
+          _dbus_string_free (&dirname);
+          continue;
+        }
+
+      if (!_dbus_string_init (&filename))
+        {
+          _dbus_directory_close (dir);
+          _dbus_string_free (&dirname);
+          BUS_SET_OOM (error);
+          goto out;
+        }
+
+      while (_dbus_directory_get_next_file (dir, &filename, &tmp_error))
+        {
+          DBusString full_path;
+          const char *name;
+          char *name_copy;
+          char *path_copy;
+          int found = -1;
+
+          if (!_dbus_string_ends_with_c_str (&filename, ".conf"))
+            continue;
+
+          if (!_dbus_string_init (&full_path))
+            {
+              _dbus_string_free (&filename);
+              _dbus_directory_close (dir);
+              _dbus_string_free (&dirname);
+              BUS_SET_OOM (error);
+              goto out;
+            }
+
+          if (!_dbus_string_copy (&dirname, 0, &full_path, 0) ||
+              !_dbus_concat_dir_and_file (&full_path, &filename))
+            {
+              _dbus_string_free (&full_path);
+              _dbus_string_free (&filename);
+              _dbus_directory_close (dir);
+              _dbus_string_free (&dirname);
+              BUS_SET_OOM (error);
+              goto out;
+            }
+
+          name = _dbus_string_get_const_data (&filename);
+
+          for (j = 0; j < n_names; j++)
+            {
+              if (strcmp (names[j], name) == 0)
+                {
+                  found = j;
+                  break;
+                }
+            }
+
+          name_copy = _dbus_strdup (name);
+          path_copy = _dbus_strdup (_dbus_string_get_const_data (&full_path));
+          _dbus_string_free (&full_path);
+
+          if (name_copy == NULL || path_copy == NULL)
+            {
+              dbus_free (name_copy);
+              dbus_free (path_copy);
+              _dbus_string_free (&filename);
+              _dbus_directory_close (dir);
+              _dbus_string_free (&dirname);
+              BUS_SET_OOM (error);
+              goto out;
+            }
+
+          if (found >= 0)
+            {
+              dbus_free (name_copy);
+              dbus_free (paths[found]);
+              paths[found] = path_copy;
+            }
+          else
+            {
+              char **new_names = dbus_realloc (names, sizeof (char *) * (size_t) (n_names + 1));
+              char **new_paths;
+
+              if (new_names == NULL)
+                {
+                  dbus_free (name_copy);
+                  dbus_free (path_copy);
+                  _dbus_string_free (&filename);
+                  _dbus_directory_close (dir);
+                  _dbus_string_free (&dirname);
+                  BUS_SET_OOM (error);
+                  goto out;
+                }
+
+              names = new_names;
+              new_paths = dbus_realloc (paths, sizeof (char *) * (size_t) (n_names + 1));
+
+              if (new_paths == NULL)
+                {
+                  dbus_free (name_copy);
+                  dbus_free (path_copy);
+                  _dbus_string_free (&filename);
+                  _dbus_directory_close (dir);
+                  _dbus_string_free (&dirname);
+                  BUS_SET_OOM (error);
+                  goto out;
+                }
+
+              paths = new_paths;
+              names[n_names] = name_copy;
+              paths[n_names] = path_copy;
+              n_names++;
+            }
+        }
+
+      _dbus_string_free (&filename);
+      _dbus_directory_close (dir);
+      _dbus_string_free (&dirname);
+      dbus_error_free (&tmp_error);
+    }
+
+  /*
+   * Sort by basename, then include the survivors. A link to /dev/null is a
+   * mask, so it occupies the name without contributing any rules.
+   */
+  for (j = 0; j < n_names; j++)
+    {
+      int k;
+
+      for (k = j + 1; k < n_names; k++)
+        {
+          if (basename_compare (&names[j], &names[k]) > 0)
+            {
+              char *tmp_name = names[j];
+              char *tmp_path = paths[j];
+
+              names[j] = names[k];
+              names[k] = tmp_name;
+              paths[j] = paths[k];
+              paths[k] = tmp_path;
+            }
+        }
+    }
+
+  for (j = 0; j < n_names; j++)
+    {
+      DBusString full_path;
+      DBusStat stat_buf;
+      dbus_bool_t masked = FALSE;
+
+      if (!_dbus_string_init (&full_path))
+        {
+          BUS_SET_OOM (error);
+          goto out;
+        }
+
+      if (!_dbus_string_append (&full_path, paths[j]))
+        {
+          _dbus_string_free (&full_path);
+          BUS_SET_OOM (error);
+          goto out;
+        }
+
+      /*
+       * A link to /dev/null resolves to a character device rather than a
+       * regular file, so anything that is not a regular file masks the lower
+       * tiers without contributing rules.
+       */
+      if (_dbus_stat (&full_path, &stat_buf, NULL) &&
+          !S_ISREG (stat_buf.mode))
+        masked = TRUE;
+
+      if (!masked && !include_file (parser, &full_path, TRUE, error))
+        {
+          _dbus_string_free (&full_path);
+          goto out;
+        }
+
+      _dbus_string_free (&full_path);
+    }
+
+  retval = TRUE;
+
+ out:
+  for (j = 0; j < n_names; j++)
+    {
+      dbus_free (names[j]);
+      dbus_free (paths[j]);
+    }
+  dbus_free (names);
+  dbus_free (paths);
+
+  return retval;
+}
+
 static dbus_bool_t
 include_dir (BusConfigParser   *parser,
              const DBusString  *dirname,
@@ -2728,6 +3010,15 @@
       }
       break;
       
+    case ELEMENT_INCLUDEDIRS:
+      {
+        e->had_content = TRUE;
+
+        if (!include_dir_family (parser, content, error))
+          return FALSE;
+      }
+      break;
+
     case ELEMENT_INCLUDEDIR:
       {
         DBusString full_path;
@@ -3387,6 +3678,7 @@
     case ELEMENT_SERVICEDIR:
     case ELEMENT_SERVICEHELPER:
     case ELEMENT_INCLUDEDIR:
+    case ELEMENT_INCLUDEDIRS:
     case ELEMENT_CONFIGTYPE:
     case ELEMENT_SELINUX:
     case ELEMENT_ASSOCIATE:
