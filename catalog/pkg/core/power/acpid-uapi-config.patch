+/*
+ * read in all the configuration files from a single directory
+ */
+int
+acpid_read_conf(const char *confdir)
+{
+	int nrules;
+
+	lock_rules();
+	nrules = scan_conf_dir(confdir, NULL);
+	unlock_rules();
+
+	if (nrules < 0)
+		return -1;
+
+	acpid_log(LOG_INFO, "%d rule%s loaded", nrules, (nrules == 1)?"":"s");
+
+	return 0;
+}
+
+/*
+ * read in all the configuration files across a set of directories,
+ * given highest-priority first; a directory's files shadow
+ * same-named files from every directory that follows it
+ */
+int
+acpid_read_conf_tiers(const char *const *confdirs, int nconfdirs)
+{
+	struct name_set seen = { NULL, 0, 0 };
+	int nrules = 0;
+	int i;
+
+	lock_rules();
+	for (i = 0; i < nconfdirs; i++) {
+		int n = scan_conf_dir(confdirs[i], &seen);
+		if (n < 0) {
+			name_set_free(&seen);
+			unlock_rules();
+			return -1;
+		}
+		nrules += n;
+	}
+	name_set_free(&seen);
 	unlock_rules();
 
 	acpid_log(LOG_INFO, "%d rule%s loaded", nrules, (nrules == 1)?"":"s");
