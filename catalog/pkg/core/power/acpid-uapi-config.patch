+/*
+ * read acpid's configuration, either from the single directory the
+ * admin gave with -c, or from the vendor, run, and /etc tiers, /etc
+ * winning over /run winning over the vendor tier
+ */
+static int
+read_conf(void)
+{
+	static const char *tiers[] = {
+		ACPID_CONFDIR,
+		ACPID_CONFDIR_RUN,
+		ACPID_CONFDIR_VENDOR,
+	};
+
+	if (confdir_set)
+		return acpid_read_conf(confdir);
+	return acpid_read_conf_tiers(tiers, sizeof(tiers) / sizeof(tiers[0]));
+}
