+struct name_set {
+	char **names;
+	int n;
+	int cap;
+};
+
+static int
+name_set_contains(struct name_set *seen, const char *name)
+{
+	int i;
+
+	if (!seen)
+		return 0;
+	for (i = 0; i < seen->n; i++) {
+		if (!strcmp(seen->names[i], name))
+			return 1;
+	}
+	return 0;
+}
+
+static void
+name_set_add(struct name_set *seen, const char *name)
+{
+	if (!seen)
+		return;
+	if (seen->n == seen->cap) {
+		seen->cap = seen->cap ? seen->cap * 2 : 16;
+		seen->names = realloc(seen->names, seen->cap * sizeof(char *));
+	}
+	seen->names[seen->n++] = strdup(name);
+}
+
+static void
+name_set_free(struct name_set *seen)
+{
+	int i;
+
+	for (i = 0; i < seen->n; i++)
+		free(seen->names[i]);
+	free(seen->names);
+}
+
+/* is this dirent a symlink to /dev/null, i.e. a mask? */
+static int
+is_devnull_mask(DIR *dir, const char *name)
+{
+	char buf[PATH_MAX];
+	ssize_t len;
+
+	len = readlinkat(dirfd(dir), name, buf, sizeof(buf) - 1);
+	if (len < 0)
+		return 0; /* not a symlink, or unreadable: not a mask */
+	buf[len] = '\0';
+	return !strcmp(buf, "/dev/null");
+}
