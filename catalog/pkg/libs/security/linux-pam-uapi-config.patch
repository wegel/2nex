diff -urN a/tests/tst-pam_config.c b/tests/tst-pam_config.c
--- a/tests/tst-pam_config.c
+++ b/tests/tst-pam_config.c
@@ -0,0 +1,159 @@
+/* Test administrator, runtime, and vendor configuration selection. */
+
+#include "config.h"
+
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "pam_config.h"
+
+static void
+fail(const char *message)
+{
+	perror(message);
+	exit(EXIT_FAILURE);
+}
+
+static void
+make_dir(const char *path)
+{
+	if (mkdir(path, 0700) != 0)
+		fail(path);
+}
+
+static void
+make_file(const char *path)
+{
+	FILE *file = fopen(path, "w");
+
+	if (file == NULL)
+		fail(path);
+	if (fclose(file) != 0)
+		fail(path);
+}
+
+static void
+format_path(char *path, size_t size, const char *root,
+	    const char *tier, const char *name)
+{
+	int length = snprintf(path, size, "%s/%s/%s", root, tier, name);
+
+	if (length < 0 || (size_t) length >= size) {
+		errno = ENAMETOOLONG;
+		fail("configuration test path");
+	}
+}
+
+static void
+expect_path(const char *actual, const char *expected)
+{
+	if (actual == NULL || strcmp(actual, expected) != 0) {
+		fprintf(stderr, "expected path %s, got %s\n", expected,
+			actual == NULL ? "(null)" : actual);
+		exit(EXIT_FAILURE);
+	}
+}
+
+static void
+expect_files(char **actual, char *const *expected, size_t count)
+{
+	if (actual == NULL) {
+		fprintf(stderr, "configuration file list is null\n");
+		exit(EXIT_FAILURE);
+	}
+
+	for (size_t i = 0; i < count; i++) {
+		expect_path(actual[i], expected[i]);
+		free(actual[i]);
+		free(expected[i]);
+	}
+	if (actual[count] != NULL) {
+		fprintf(stderr, "configuration file list has extra entries\n");
+		exit(EXIT_FAILURE);
+	}
+	free(actual);
+}
+
+int
+main(void)
+{
+	char root[] = "tst-pam-config-XXXXXX";
+	char admin[PATH_MAX];
+	char runtime[PATH_MAX];
+	char vendor[PATH_MAX];
+	char admin_pattern[PATH_MAX];
+	char runtime_pattern[PATH_MAX];
+	char vendor_pattern[PATH_MAX];
+	char admin_file[PATH_MAX];
+	char runtime_file[PATH_MAX];
+	char vendor_file[PATH_MAX];
+	char *expected[4];
+	char **files;
+
+	if (mkdtemp(root) == NULL)
+		fail("mkdtemp");
+	format_path(admin, sizeof(admin), root, "etc", "security");
+	format_path(runtime, sizeof(runtime), root, "run", "security");
+	format_path(vendor, sizeof(vendor), root, "usr", "security");
+
+	char path[PATH_MAX];
+	format_path(path, sizeof(path), root, "etc", "");
+	make_dir(path);
+	format_path(path, sizeof(path), root, "run", "");
+	make_dir(path);
+	format_path(path, sizeof(path), root, "usr", "");
+	make_dir(path);
+	make_dir(admin);
+	make_dir(runtime);
+	make_dir(vendor);
+
+	format_path(admin_file, sizeof(admin_file), root, "etc/security", "main.conf");
+	format_path(runtime_file, sizeof(runtime_file), root, "run/security", "main.conf");
+	format_path(vendor_file, sizeof(vendor_file), root, "usr/security", "main.conf");
+	make_file(vendor_file);
+	expect_path(_pam_config_path(admin_file, runtime_file, vendor_file), vendor_file);
+	make_file(runtime_file);
+	expect_path(_pam_config_path(admin_file, runtime_file, vendor_file), runtime_file);
+	make_file(admin_file);
+	expect_path(_pam_config_path(admin_file, runtime_file, vendor_file), admin_file);
+	if (unlink(admin_file) != 0 || unlink(runtime_file) != 0 ||
+	    unlink(vendor_file) != 0)
+		fail("unlink main configuration");
+
+	format_path(admin_pattern, sizeof(admin_pattern), root, "etc/security", "*.conf");
+	format_path(runtime_pattern, sizeof(runtime_pattern), root, "run/security", "*.conf");
+	format_path(vendor_pattern, sizeof(vendor_pattern), root, "usr/security", "*.conf");
+
+	format_path(vendor_file, sizeof(vendor_file), root, "usr/security", "10-vendor.conf");
+	make_file(vendor_file);
+	expected[0] = strdup(vendor_file);
+	format_path(vendor_file, sizeof(vendor_file), root, "usr/security", "20-shadowed.conf");
+	make_file(vendor_file);
+
+	format_path(runtime_file, sizeof(runtime_file), root, "run/security", "20-shadowed.conf");
+	make_file(runtime_file);
+	expected[1] = strdup(runtime_file);
+	format_path(runtime_file, sizeof(runtime_file), root, "run/security", "30-shadowed.conf");
+	make_file(runtime_file);
+
+	format_path(admin_file, sizeof(admin_file), root, "etc/security", "30-shadowed.conf");
+	make_file(admin_file);
+	expected[2] = strdup(admin_file);
+	format_path(admin_file, sizeof(admin_file), root, "etc/security", "40-admin.conf");
+	make_file(admin_file);
+	expected[3] = strdup(admin_file);
+	for (size_t i = 0; i < 4; i++) {
+		if (expected[i] == NULL)
+			fail("strdup");
+	}
+
+	files = _pam_config_files(admin_pattern, runtime_pattern, vendor_pattern);
+	expect_files(files, expected, 4);
+
+	return EXIT_SUCCESS;
+}
