diff -urN a/libpam_internal/pam_config.c b/libpam_internal/pam_config.c
--- a/libpam_internal/pam_config.c
+++ b/libpam_internal/pam_config.c
@@ -0,0 +1,134 @@
+/* pam_config.c -- common system configuration path helpers */
+
+#include "config.h"
+
+#include <errno.h>
+#include <glob.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#include "pam_config.h"
+
+static const char *
+base_name(const char *path)
+{
+    const char *base = strrchr(path, '/');
+
+    return base != NULL ? base + 1 : path;
+}
+
+const char *
+_pam_config_path(const char *admin_path,
+                 const char *runtime_path,
+                 const char *vendor_path)
+{
+    struct stat buffer;
+
+    if (admin_path != NULL &&
+        (stat(admin_path, &buffer) == 0 || errno != ENOENT))
+        return admin_path;
+
+    if (runtime_path != NULL &&
+        (stat(runtime_path, &buffer) == 0 || errno != ENOENT))
+        return runtime_path;
+
+    return vendor_path != NULL ? vendor_path : admin_path;
+}
+
+static bool
+has_base_name(char *const *files, size_t count, const char *candidate)
+{
+    const char *candidate_base = base_name(candidate);
+
+    for (size_t i = 0; i < count; i++) {
+        if (strcmp(base_name(files[i]), candidate_base) == 0)
+            return true;
+    }
+
+    return false;
+}
+
+static int
+append_pattern(char ***files, size_t *count, const char *pattern)
+{
+    glob_t matches = { 0 };
+    int result;
+
+    if (pattern == NULL)
+        return 0;
+
+    result = glob(pattern, GLOB_ERR | GLOB_NOSORT, NULL, &matches);
+    if (result == GLOB_NOMATCH)
+        return 0;
+    if (result != 0) {
+        errno = result == GLOB_NOSPACE ? ENOMEM : EIO;
+        globfree(&matches);
+        return -1;
+    }
+
+    for (size_t i = 0; i < matches.gl_pathc; i++) {
+        char **new_files;
+
+        if (has_base_name(*files, *count, matches.gl_pathv[i]))
+            continue;
+
+        new_files = realloc(*files, (*count + 2) * sizeof(**files));
+        if (new_files == NULL) {
+            globfree(&matches);
+            return -1;
+        }
+        *files = new_files;
+        (*files)[*count] = strdup(matches.gl_pathv[i]);
+        if ((*files)[*count] == NULL) {
+            globfree(&matches);
+            return -1;
+        }
+        (*count)++;
+        (*files)[*count] = NULL;
+    }
+
+    globfree(&matches);
+    return 0;
+}
+
+static int
+compare_filename(const void *a, const void *b)
+{
+    const char *const *left = a;
+    const char *const *right = b;
+
+    return strcmp(base_name(*left), base_name(*right));
+}
+
+char **
+_pam_config_files(const char *admin_pattern,
+                  const char *runtime_pattern,
+                  const char *vendor_pattern)
+{
+    const char *patterns[] = {
+        admin_pattern,
+        runtime_pattern,
+        vendor_pattern,
+    };
+    char **files = calloc(1, sizeof(*files));
+    size_t count = 0;
+
+    if (files == NULL)
+        return NULL;
+
+    for (size_t i = 0; i < sizeof(patterns) / sizeof(patterns[0]); i++) {
+        if (append_pattern(&files, &count, patterns[i]) < 0)
+            goto error;
+    }
+
+    qsort(files, count, sizeof(*files), compare_filename);
+    return files;
+
+error:
+    for (size_t i = 0; i < count; i++)
+        free(files[i]);
+    free(files);
+    return NULL;
+}
