+// Return true if any file already recorded in out_files has the same basename as basename. Scanning the
+// already-accumulated out_files list (instead of keeping a separate claim table) means there is no extra
+// allocation that can fail independently of out_files's own allocation, which add_if_manifest_file already
+// reports through the ordinary VkResult error path.
+static bool loader_out_files_has_basename(const struct loader_string_list *out_files, const char *basename) {
+    for (uint32_t i = 0; i < out_files->count; i++) {
+        if (strcmp(loader_data_file_basename(out_files->list[i]), basename) == 0) {
+            return true;
