+// Remove duplicate path entries from a PATH_SEPARATOR-delimited search path in place, updating *path_size to the
+// new length. Shared by every search_path buffer this file builds (override, additive, implicit).
+static void loader_dedup_search_path(char *path, size_t *path_size) {
+    char path_sep_str[2] = {PATH_SEPARATOR, '\0'};
+    size_t updated_size = *path_size;
+    for (size_t first = 0; first < updated_size;) {
+        // If this is an empty path, erase it
+        if (path[first] == PATH_SEPARATOR) {
+            memmove(&path[first], &path[first + 1], updated_size - first + 1);
+            updated_size -= 1;
+            continue;
+        }
+
+        size_t first_end = first + 1;
+        first_end += strcspn(&path[first_end], path_sep_str);
+        for (size_t second = first_end + 1; second < updated_size;) {
+            size_t second_end = second + 1;
+            second_end += strcspn(&path[second_end], path_sep_str);
+            if (first_end - first == second_end - second && !strncmp(&path[first], &path[second], second_end - second)) {
+                // Found duplicate. Include PATH_SEPARATOR in second_end, then erase it from path.
+                if (path[second_end] == PATH_SEPARATOR) {
+                    second_end++;
+                }
+                memmove(&path[second], &path[second_end], updated_size - second_end + 1);
+                updated_size -= second_end - second;
+            } else {
+                second = second_end + 1;
+            }
+        }
+        first = first_end + 1;
+    }
+    *path_size = updated_size;
+}
