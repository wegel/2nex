+// One retained candidate for a merged default-directory scan: the JSON
+// basename and the full path of the highest-priority file with that name.
+struct VendorConfigEntry
+{
+    char *baseName;
+    char *path;
+};
+
+static int VendorConfigEntryExists(struct VendorConfigEntry *entries, size_t count,
+        const char *baseName)
+{
+    size_t i;
+    for (i=0; i<count; i++) {
+        if (strcmp(entries[i].baseName, baseName) == 0) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int CompareVendorConfigEntries(const void *a, const void *b)
+{
+    const struct VendorConfigEntry *ea = (const struct VendorConfigEntry *) a;
+    const struct VendorConfigEntry *eb = (const struct VendorConfigEntry *) b;
+    return strcmp(ea->baseName, eb->baseName);
+}
+
+void LoadVendorsFromConfigDirs(char * const *dirNames)
+{
+    struct VendorConfigEntry *entries = NULL;
+    size_t entryCount = 0;
+    size_t entryAlloc = 0;
+    size_t d;
+    size_t i;
+
+    for (d=0; dirNames[d] != NULL; d++) {
+        const char *dirName = dirNames[d];
+        struct dirent **dirEntries = NULL;
+        size_t dirnameLen;
+        const char *pathSep;
+        int count;
+
+        count = scandir(dirName, &dirEntries, ScandirFilter, CompareFilenames);
+        if (count <= 0) {
+            continue;
+        }
+
+        dirnameLen = strlen(dirName);
+        if (dirnameLen > 0 && dirName[dirnameLen - 1] != '/') {
+            pathSep = "/";
+        } else {
+            pathSep = "";
+        }
+
+        for (i=0; i<(size_t) count; i++) {
+            // A file whose basename was already claimed by a
+            // higher-priority directory is masked: skip it, whether or not
+            // the higher-priority file will itself parse successfully.
+            if (!VendorConfigEntryExists(entries, entryCount, dirEntries[i]->d_name)) {
+                char *path = NULL;
+                if (glvnd_asprintf(&path, "%s%s%s", dirName, pathSep, dirEntries[i]->d_name) > 0) {
+                    if (entryCount == entryAlloc) {
+                        size_t newAlloc = (entryAlloc > 0) ? entryAlloc * 2 : 8;
+                        struct VendorConfigEntry *newEntries = NULL;
+                        if (entryAlloc <= SIZE_MAX / 2 &&
+                                newAlloc <= SIZE_MAX / sizeof(*newEntries)) {
+                            newEntries = (struct VendorConfigEntry *)
+                                realloc(entries, newAlloc * sizeof(*newEntries));
+                        }
+                        if (newEntries == NULL) {
+                            fprintf(stderr, "ERROR: Could not allocate vendor config entry list\n");
+                            free(path);
+                            path = NULL;
+                        } else {
+                            entries = newEntries;
+                            entryAlloc = newAlloc;
+                        }
+                    }
+                    if (path != NULL) {
+                        char *baseName = strdup(dirEntries[i]->d_name);
+                        if (baseName == NULL) {
+                            fprintf(stderr, "ERROR: Could not allocate vendor config basename\n");
+                            free(path);
+                        } else {
+                            entries[entryCount].baseName = baseName;
+                            entries[entryCount].path = path;
+                            entryCount++;
+                        }
+                    }
+                } else {
+                    fprintf(stderr, "ERROR: Could not allocate vendor library path name\n");
+                }
+            }
+            free(dirEntries[i]);
+        }
+        free(dirEntries);
+    }
+
+    // Load the retained files in bytewise basename order, independent of
+    // which directory each one came from.
+    if (entryCount > 1) {
+        qsort(entries, entryCount, sizeof(struct VendorConfigEntry), CompareVendorConfigEntries);
+    }
+
+    for (i=0; i<entryCount; i++) {
+        LoadVendorFromConfigFile(entries[i].path);
+        free(entries[i].baseName);
+        free(entries[i].path);
+    }
+    free(entries);
+}
