+static int
+FcSortCmpConfigFile (const void *a, const void *b)
+{
+    const FcChar8 *as = *((FcChar8 **)a);
+    const FcChar8 *bs = *((FcChar8 **)b);
+    const FcChar8 *abase = (const FcChar8 *)strrchr ((const char *)as, FC_DIR_SEPARATOR);
+    const FcChar8 *bbase = (const FcChar8 *)strrchr ((const char *)bs, FC_DIR_SEPARATOR);
+
+    return FcStrCmp (abase ? abase + 1 : as, bbase ? bbase + 1 : bs);
+}
+
+static FcChar8 *
+FcConfigPathFilename (FcConfig      *config,
+                      const FcChar8 *path,
+                      const FcChar8 *name)
+{
+    const FcChar8 *sysroot = FcConfigGetSysRoot (config);
+    const FcChar8 *rootpath = path;
+
+    if (sysroot && FcStrIsAbsoluteFilename (path)) {
+	size_t len = strlen ((const char *)sysroot);
+
+	if (strncmp ((const char *)path, (const char *)sysroot, len) == 0)
+	    sysroot = NULL;
+	else
+	    while (*rootpath == FC_DIR_SEPARATOR)
+		rootpath++;
+    } else
+	sysroot = NULL;
+
+    if (sysroot)
+	return name ? FcStrBuildFilename (sysroot, rootpath, name, NULL)
+	            : FcStrBuildFilename (sysroot, rootpath, NULL);
+    return name ? FcStrBuildFilename (path, name, NULL) : FcStrCopy (path);
+}
+
+static FcBool
+FcConfigAddPathRoots (FcConfig *config)
+{
+    FcChar8 **paths = FcConfigGetPath();
+    FcBool    ret = FcTrue;
+
+    if (!paths)
+	return FcFalse;
+    for (FcChar8 **p = paths; *p; p++) {
+	FcChar8 *path = FcConfigPathFilename (config, *p, NULL);
+
+	if (!path || !FcConfigAddConfigDir (config, path))
+	    ret = FcFalse;
+	if (path)
+	    FcStrFree (path);
+    }
+    FcConfigFreePath (paths);
+    return ret;
+}
+
+static FcBool
+FcConfigParseAndLoadPathDirs (FcConfig      *config,
+                              const FcChar8 *name,
+                              FcBool         complain,
+                              FcBool         load)
+{
+    FcChar8 **paths = FcConfigGetPath();
+    FcStrSet *files = NULL, *seen = NULL;
+    FcBool    found = FcFalse, ret = FcTrue;
+
+    if (!paths)
+	return FcFalse;
+    files = FcStrSetCreateEx (FCSS_GROW_BY_64);
+    seen = FcStrSetCreateEx (FCSS_GROW_BY_64);
+    if (!files || !seen) {
+	ret = FcFalse;
+	goto bail;
+    }
+
+    for (FcChar8 **p = paths; ret && *p; p++) {
+	FcChar8 *dir = FcConfigPathFilename (config, *p, name);
+	struct dirent *entry;
+	DIR *d;
+
+	if (!dir) {
+	    ret = FcFalse;
+	    break;
+	}
+	if (load && !FcConfigAddConfigDir (config, dir)) {
+	    FcStrFree (dir);
+	    ret = FcFalse;
+	    break;
+	}
+	d = opendir ((const char *)dir);
+	if (!d) {
+	    FcStrFree (dir);
+	    continue;
+	}
+	found = FcTrue;
+	while (ret && (entry = readdir (d))) {
+	    FcChar8 *file;
+	    struct stat statb;
+	    int len = strlen (entry->d_name);
+
+	    if (entry->d_name[0] < '0' || entry->d_name[0] > '9' ||
+	        len <= 5 || strcmp (entry->d_name + len - 5, ".conf") != 0 ||
+	        FcStrSetMember (seen, (const FcChar8 *)entry->d_name))
+		continue;
+	    if (!FcStrSetAdd (seen, (const FcChar8 *)entry->d_name)) {
+		ret = FcFalse;
+		break;
+	    }
+	    file = FcStrBuildFilename (dir, entry->d_name, NULL);
+	    if (!file) {
+		ret = FcFalse;
+		break;
+	    }
+	    if (FcStat (file, &statb) == 0 && statb.st_size == 0) {
+		if (load)
+		    ret = FcConfigAddConfigFile (config, file);
+	    } else
+		ret = FcStrSetAdd (files, file);
+	    FcStrFree (file);
+	}
+	closedir (d);
+	FcStrFree (dir);
+    }
+
+    if (ret) {
+	qsort (files->strs, files->num, sizeof (FcChar8 *),
+	       (int (*) (const void *, const void *))FcSortCmpConfigFile);
+	for (int i = 0; ret && i < files->num; i++)
+	    ret = _FcConfigParse (config, files->strs[i], complain, load);
+    }
+
+bail:
+    if (seen)
+	FcStrSetDestroy (seen);
+    if (files)
+	FcStrSetDestroy (files);
+    FcConfigFreePath (paths);
+    return (found && ret) || !complain;
+}
+
