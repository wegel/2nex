@@ -463,0 +562,35 @@
+/*
+ * Fold a fully-shadowed vendor/runtime/administrator combination into
+ * the (possibly user-populated) result. A name already present in
+ * "configs" keeps taking priority and only has its unset fields filled
+ * in, exactly as a single system directory always did; a name not yet
+ * present moves over as-is.
+ */
+static bool
+merge_system_configs (p11_dict *configs,
+                      p11_dict *sysconfigs)
+{
+	p11_dictiter iter;
+	void *key;
+	void *value;
+	char *stolen_key;
+	p11_dict *stolen_config;
+	p11_dict *prev;
+
+	p11_dict_iterate (sysconfigs, &iter);
+	while (p11_dict_next (&iter, &key, &value)) {
+		prev = p11_dict_get (configs, key);
+		if (prev == NULL) {
+			if (!p11_dict_steal (sysconfigs, key, (void **)&stolen_key, (void **)&stolen_config))
+				assert_not_reached ();
+			if (!p11_dict_set (configs, stolen_key, stolen_config))
+				return_val_if_reached (false);
+		} else {
+			if (!_p11_conf_merge_defaults (prev, value))
+				return false;
+		}
+	}
+
+	return true;
+}
